<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.capteur.controllers.ModifierMaintenanceController"
      prefWidth="720" prefHeight="460">

    <!-- ══ SIDEBAR ══ -->
    <VBox prefWidth="200" spacing="0"
          style="-fx-background-color: linear-gradient(to bottom, #4c1d95, #6d28d9, #7c3aed);
                 -fx-padding: 28 18 22 18;">

        <VBox spacing="8" alignment="CENTER"
              style="-fx-padding: 0 0 20 0;
                     -fx-border-color: rgba(255,255,255,0.15);
                     -fx-border-width: 0 0 1 0;">
            <ImageView fitWidth="46" fitHeight="46" preserveRatio="true">
                <image><Image url="@/logo.png"/></image>
            </ImageView>
            <Label text="ForestGuard"
                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Modifier Maintenance"
                   style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.7);
                          -fx-text-alignment: center; -fx-wrap-text: true;"/>
        </VBox>

        <VBox spacing="3" style="-fx-padding: 18 0 0 0;">
            <Label text="STATUTS POSSIBLES"
                   style="-fx-font-size: 9; -fx-font-weight: bold;
                          -fx-text-fill: rgba(255,255,255,0.45);
                          -fx-letter-spacing: 1; -fx-padding: 0 0 6 0;"/>
            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 7 10;">
                <Label text="📅" style="-fx-font-size: 13;"/>
                <VBox spacing="1">
                    <Label text="Planifiée"
                           style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.8);"/>
                    <Label text="En attente"
                           style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.45);"/>
                </VBox>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT"
                  style="-fx-background-color: rgba(255,255,255,0.12);
                         -fx-background-radius: 8; -fx-padding: 7 10;">
                <Label text="⚙" style="-fx-font-size: 13;"/>
                <VBox spacing="1">
                    <Label text="En cours"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Intervention active"
                           style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.55);"/>
                </VBox>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 7 10;">
                <Label text="✅" style="-fx-font-size: 13;"/>
                <VBox spacing="1">
                    <Label text="Terminée"
                           style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.8);"/>
                    <Label text="Clôturée"
                           style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.45);"/>
                </VBox>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <VBox spacing="4"
              style="-fx-background-color: rgba(0,0,0,0.2); -fx-background-radius: 10;
                     -fx-padding: 10 12;">
            <Label text="⚠ Attention"
                   style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #c4b5fd;"/>
            <Label text="Mettre à jour le statut permet de suivre l'avancement de l'intervention."
                   style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.65);
                          -fx-wrap-text: true;"/>
        </VBox>
    </VBox>

    <!-- ══ FORMULAIRE ══ -->
    <VBox HBox.hgrow="ALWAYS" spacing="0"
          style="-fx-background-color: #f8fafc;">

        <!-- Header -->
        <VBox style="-fx-padding: 22 26 16 26; -fx-background-color: white;
                     -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
            <Label text="Modifier la maintenance"
                   style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <Label text="Modifiez les informations de la maintenance sélectionnée"
                   style="-fx-font-size: 11; -fx-text-fill: #94a3b8; -fx-padding: 2 0 0 0;"/>
        </VBox>

        <!-- Champs -->
        <VBox spacing="12" VBox.vgrow="ALWAYS"
              style="-fx-padding: 18 26 12 26;">

            <!-- Ligne 1 : Date + Type -->
            <HBox spacing="14">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="DATE *"
                           style="-fx-font-size: 10; -fx-font-weight: bold;
                                  -fx-text-fill: #475569; -fx-letter-spacing: 0.5;"/>
                    <DatePicker fx:id="dpDate" maxWidth="Infinity" prefHeight="40"
                                style="-fx-background-color: white;
                                       -fx-border-color: #e2e8f0; -fx-border-radius: 10;
                                       -fx-background-radius: 10; -fx-font-size: 13;"/>
                    <Label fx:id="lblErreurDate" text="" visible="false" managed="false"
                           style="-fx-font-size: 10; -fx-text-fill: #dc2626; -fx-padding: 2 0 0 2;"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="TYPE *"
                           style="-fx-font-size: 10; -fx-font-weight: bold;
                                  -fx-text-fill: #475569; -fx-letter-spacing: 0.5;"/>
                    <ComboBox fx:id="cbType" maxWidth="Infinity" prefHeight="40"
                              style="-fx-background-color: white;
                                     -fx-border-color: #e2e8f0; -fx-border-radius: 10;
                                     -fx-background-radius: 10; -fx-font-size: 13;"/>
                    <Label fx:id="lblErreurType" text="" visible="false" managed="false"
                           style="-fx-font-size: 10; -fx-text-fill: #dc2626; -fx-padding: 2 0 0 2;"/>
                </VBox>
            </HBox>

            <!-- Ligne 2 : Statut (pleine largeur — lisible) -->
            <VBox spacing="4">
                <Label text="STATUT *"
                       style="-fx-font-size: 10; -fx-font-weight: bold;
                              -fx-text-fill: #475569; -fx-letter-spacing: 0.5;"/>
                <ComboBox fx:id="cbStatut" maxWidth="Infinity" prefHeight="40"
                          style="-fx-background-color: white;
                                 -fx-border-color: #ddd6fe; -fx-border-radius: 10;
                                 -fx-background-radius: 10; -fx-font-size: 13;"/>
                <Label fx:id="lblErreurStatut" text="" visible="false" managed="false"
                       style="-fx-font-size: 10; -fx-text-fill: #dc2626; -fx-padding: 2 0 0 2;"/>
            </VBox>

            <!-- Ligne 3 : Description (même ComboBox que l'ajout) -->
            <VBox spacing="4">
                <Label text="DESCRIPTION"
                       style="-fx-font-size: 10; -fx-font-weight: bold;
                              -fx-text-fill: #475569; -fx-letter-spacing: 0.5;"/>
                <ComboBox fx:id="cbDescription" maxWidth="Infinity" prefHeight="40"
                          promptText="Sélectionner ou saisir une description..."
                          style="-fx-background-color: white;
                                 -fx-border-color: #e2e8f0; -fx-border-radius: 10;
                                 -fx-background-radius: 10; -fx-font-size: 13;"/>
                <Label fx:id="lblErreurDescription" text="" visible="false" managed="false"
                       style="-fx-font-size: 10; -fx-text-fill: #dc2626; -fx-padding: 2 0 0 2;"/>
            </VBox>
        </VBox>

        <!-- Footer -->
        <HBox spacing="10" alignment="CENTER_RIGHT"
              style="-fx-padding: 12 26 18 26; -fx-background-color: white;
                     -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">
            <Button text="Annuler" onAction="#annuler"
                    prefHeight="40" prefWidth="100"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b;
                           -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-background-radius: 10; -fx-border-color: #e2e8f0;
                           -fx-border-radius: 10; -fx-cursor: hand;"/>
            <Button text="💾  Enregistrer les modifications" onAction="#modifier"
                    prefHeight="40"
                    style="-fx-background-color: #7c3aed; -fx-text-fill: white;
                           -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 22;
                           -fx-effect: dropshadow(gaussian,rgba(124,58,237,0.4),10,0,0,3);"/>
        </HBox>
    </VBox>
</HBox>
