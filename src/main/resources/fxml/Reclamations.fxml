<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<!-- CONTENU PRINCIPAL SANS SIDEBAR -->
<StackPane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.ReclamationsController"
      prefHeight="720.0" prefWidth="1060.0"
      style="-fx-background-color: transparent;">
    <VBox style="-fx-background-color:#0a1612;">

        <!-- BANNIÈRE -->
        <StackPane prefHeight="90" minHeight="90" maxHeight="90">
            <ImageView fitWidth="1060" fitHeight="90" preserveRatio="false">
                <image><Image url="@../brinis2.jpg"/></image>
            </ImageView>
            <Pane style="-fx-background-color:linear-gradient(to right,rgba(10,22,18,0.92),rgba(10,22,18,0.5));"/>
            <HBox alignment="CENTER_LEFT" style="-fx-padding:0 24;" spacing="14">
                <Label text="📋" style="-fx-font-size:28;"/>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Réclamations Citoyennes"
                           style="-fx-text-fill:white;-fx-font-size:22;-fx-font-weight:bold;"/>
                    <Label text="Signalements depuis l'application citoyenne — Analyse IA disponible"
                           style="-fx-text-fill:#94a3b8;-fx-font-size:11;"/>
                </VBox>
            </HBox>
        </StackPane>

        <!-- LISTE RÉCLAMATIONS -->
        <ScrollPane fx:id="scrollReclamations" VBox.vgrow="ALWAYS"
                    fitToWidth="true"
                    style="-fx-background-color:transparent;-fx-background:transparent;
                           -fx-border-color:transparent;-fx-padding:0;">
            <VBox fx:id="conteneurReclamations" spacing="8"
                  style="-fx-padding:14 16;-fx-background-color:transparent;"/>
        </ScrollPane>
    </VBox>
</StackPane>
