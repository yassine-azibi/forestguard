<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<!-- CONTENU PRINCIPAL SANS SIDEBAR -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.UtilisateursController"
      prefHeight="720.0" prefWidth="980.0" style="-fx-background-color: transparent;">
    <VBox style="-fx-background-color:#0a1612;">
        <StackPane prefHeight="110" minHeight="110" maxHeight="110">
            <ImageView fitWidth="980" fitHeight="110" preserveRatio="false"><image><Image url="@../brinis2.jpg"/></image></ImageView>
            <Pane style="-fx-background-color:linear-gradient(to right,rgba(10,22,18,0.85),rgba(10,22,18,0.4));"/>
            <HBox alignment="CENTER_LEFT" style="-fx-padding:0 24 0 28;" spacing="14">
                <VBox HBox.hgrow="ALWAYS" spacing="4">
                    <Label text="👤  Utilisateurs" style="-fx-text-fill:white;-fx-font-size:24;-fx-font-weight:bold;"/>
                    <Label text="Liste des utilisateurs enregistres dans la base forestguard" style="-fx-text-fill:#A5D6A7;-fx-font-size:11;"/>
                </VBox>
                <Button text="↺  Actualiser" onAction="#actualiser"
                        style="-fx-background-color:rgba(255,255,255,0.1);-fx-text-fill:white;-fx-background-radius:20;-fx-border-color:rgba(255,255,255,0.25);-fx-border-radius:20;-fx-border-width:1;-fx-padding:8 16;-fx-cursor:hand;-fx-font-size:12;"/>
            </HBox>
        </StackPane>
        <HBox spacing="10" style="-fx-padding:14 20 10 20;">
            <VBox HBox.hgrow="ALWAYS" spacing="2" alignment="CENTER_LEFT"
                  style="-fx-background-color:linear-gradient(to bottom right,#0d1e35,#0f2545);-fx-background-radius:14;-fx-padding:14 18;-fx-border-color:#1a3a6e;-fx-border-radius:14;-fx-border-width:1;">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="👤" style="-fx-font-size:18;"/>
                    <Label text="TOTAL" style="-fx-text-fill:#64748b;-fx-font-size:10;-fx-font-weight:bold;"/>
                </HBox>
                <Label fx:id="lblTotal" text="0" style="-fx-text-fill:#90CAF9;-fx-font-size:32;-fx-font-weight:bold;"/>
                <Label text="utilisateurs" style="-fx-text-fill:#90CAF9;-fx-font-size:10;"/>
            </VBox>
        </HBox>
        <ScrollPane fx:id="scrollPane" VBox.vgrow="ALWAYS" fitToWidth="true"
                    style="-fx-background-color:transparent;-fx-background:transparent;-fx-border-color:transparent;-fx-padding:0 20 16 20;">
            <VBox fx:id="conteneurCartes" spacing="8" style="-fx-padding:4 4 8 4;-fx-background-color:transparent;"/>
        </ScrollPane>
    </VBox>
</StackPane>
