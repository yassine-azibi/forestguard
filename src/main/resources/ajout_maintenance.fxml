<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.capteur.controllers.AjoutMaintenanceController"
      prefWidth="760" prefHeight="560">

    <!-- ══ SIDEBAR ══ -->
    <VBox prefWidth="190" minWidth="190" maxWidth="190" spacing="0"
          style="-fx-background-color: linear-gradient(to bottom, #78350f, #92400e, #b45309);
                 -fx-padding: 24 16 20 16;">

        <VBox spacing="6" alignment="CENTER"
              style="-fx-padding: 0 0 16 0;
                     -fx-border-color: rgba(255,255,255,0.15);
                     -fx-border-width: 0 0 1 0;">
            <ImageView fitWidth="42" fitHeight="42" preserveRatio="true">
                <image><Image url="@logo.png"/></image>
            </ImageView>
            <Label text="ForestGuard"
                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Nouvelle Maintenance"
                   style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.7);
                          -fx-text-alignment: center; -fx-wrap-text: true;
                          -fx-max-width: 160;"/>
        </VBox>

        <VBox spacing="3" style="-fx-padding: 14 0 0 0;">
            <Label text="TYPES DISPONIBLES"
                   style="-fx-font-size: 9; -fx-font-weight: bold;
                          -fx-text-fill: rgba(255,255,255,0.45);
                          -fx-letter-spacing: 1; -fx-padding: 0 0 6 0;"/>
            <HBox spacing="8" alignment="CENTER_LEFT"
                  style="-fx-background-color: rgba(255,255,255,0.12);
                         -fx-background-radius: 8; -fx-padding: 7 8;">
                <Label text="🔍" style="-fx-font-size: 12;"/>
                <VBox spacing="1">
                    <Label text="Préventive"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Avant la panne"
                           style="-fx-font-size: 9; -fx-text-fill: rgba(255,255,255,0.55);"/>
                </VBox>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 7 8;">
                <Label text="🔧" style="-fx-font-size: 12;"/>
                <VBox spacing="1">
                    <Label text="Corrective"
                           style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.75);"/>
                    <Label text="Après la panne"
                           style="-fx-font-size: 9; -fx-text-fill: rgba(255,255,255,0.4);"/>
                </VBox>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 7 8;">
                <Label text="🔄" style="-fx-font-size: 12;"/>
                <VBox spacing="1">
                    <Label text="Remplacement"
                           style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.75);"/>
                    <Label text="Changement matériel"
                           style="-fx-font-size: 9; -fx-text-fill: rgba(255,255,255,0.4);"/>
                </VBox>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <VBox spacing="4"
              style="-fx-background-color: rgba(0,0,0,0.2); -fx-background-radius: 10;
                     -fx-padding: 10 12;">
            <Label text="💡 Conseil"
                   style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #fcd34d;"/>
            <Label text="Planifiez les maintenances préventives avant que les capteurs ne tombent en panne."
                   style="-fx-font-size: 9; -fx-text-fill: rgba(255,255,255,0.65);
                          -fx-wrap-text: true;"/>
        </VBox>
    </VBox>

    <!-- ══ FORMULAIRE ══ -->
    <VBox HBox.hgrow="ALWAYS" spacing="0"
          style="-fx-background-color: #f8fafc;">

        <!-- Header -->
        <VBox style="-fx-padding: 20 24 14 24; -fx-background-color: white;
                     -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
            <Label text="Planifier une maintenance"
                   style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <Label text="Tous les champs marqués * sont obligatoires"
                   style="-fx-font-size: 11; -fx-text-fill: #94a3b8; -fx-padding: 2 0 0 0;"/>
        </VBox>

        <!-- Champs -->
        <VBox spacing="10" VBox.vgrow="ALWAYS"
              style="-fx-padding: 16 24 10 24;">

            <!-- Ligne 1 : Date + Type -->
            <HBox spacing="14">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="DATE *"
                           style="-fx-font-size: 10; -fx-font-weight: bold;
                                  -fx-text-fill: #475569; -fx-letter-spacing: 0.5;"/>
                    <DatePicker fx:id="dpDate" maxWidth="Infinity" prefHeight="38"
                                style="-fx-background-color: white;
                                       -fx-border-color: #e2e8f0; -fx-border-radius: 10;
                                       -fx-background-radius: 10; -fx-font-size: 13;"/>
                    <Label fx:id="lblErreurDate" text="" visible="false" managed="false"
                           style="-fx-font-size: 10; -fx-text-fill: #dc2626;"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="TYPE *"
                           style="-fx-font-size: 10; -fx-font-weight: bold;
                                  -fx-text-fill: #475569; -fx-letter-spacing: 0.5;"/>
                    <ComboBox fx:id="cbType" maxWidth="Infinity" prefHeight="38"
                              style="-fx-background-color: white;
                                     -fx-border-color: #e2e8f0; -fx-border-radius: 10;
                                     -fx-background-radius: 10; -fx-font-size: 13;"/>
                    <Label fx:id="lblErreurType" text="" visible="false" managed="false"
                           style="-fx-font-size: 10; -fx-text-fill: #dc2626;"/>
                </VBox>
            </HBox>

            <!-- Ligne 2 : Statut pleine largeur -->
            <VBox spacing="4">
                <Label text="STATUT *"
                       style="-fx-font-size: 10; -fx-font-weight: bold;
                              -fx-text-fill: #475569; -fx-letter-spacing: 0.5;"/>
                <ComboBox fx:id="cbStatut" maxWidth="Infinity" prefHeight="38"
                          style="-fx-background-color: white;
                                 -fx-border-color: #e2e8f0; -fx-border-radius: 10;
                                 -fx-background-radius: 10; -fx-font-size: 13;"/>
                <Label fx:id="lblErreurStatut" text="" visible="false" managed="false"
                       style="-fx-font-size: 10; -fx-text-fill: #dc2626;"/>
            </VBox>

            <!-- Ligne 3 : Capteur pleine largeur -->
            <VBox spacing="4">
                <Label text="CAPTEUR CONCERNÉ *"
                       style="-fx-font-size: 10; -fx-font-weight: bold;
                              -fx-text-fill: #475569; -fx-letter-spacing: 0.5;"/>
                <ComboBox fx:id="cbCapteur" maxWidth="Infinity" prefHeight="38"
                          style="-fx-background-color: white;
                                 -fx-border-color: #fed7aa; -fx-border-radius: 10;
                                 -fx-background-radius: 10; -fx-font-size: 13;"/>
                <Label fx:id="lblErreurCapteur" text="" visible="false" managed="false"
                       style="-fx-font-size: 10; -fx-text-fill: #dc2626;"/>
            </VBox>

            <!-- Ligne 4 : Description pleine largeur -->
            <VBox spacing="4">
                <Label text="DESCRIPTION"
                       style="-fx-font-size: 10; -fx-font-weight: bold;
                              -fx-text-fill: #475569; -fx-letter-spacing: 0.5;"/>
                <ComboBox fx:id="cbDescription" maxWidth="Infinity" prefHeight="38"
                          promptText="Sélectionner ou saisir une description..."
                          style="-fx-background-color: white;
                                 -fx-border-color: #e2e8f0; -fx-border-radius: 10;
                                 -fx-background-radius: 10; -fx-font-size: 13;"/>
                <Label fx:id="lblErreurDescription" text="" visible="false" managed="false"
                       style="-fx-font-size: 10; -fx-text-fill: #dc2626;"/>
            </VBox>
        </VBox>

        <!-- Footer -->
        <HBox spacing="10" alignment="CENTER_RIGHT"
              style="-fx-padding: 12 24 16 24; -fx-background-color: white;
                     -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">
            <Button text="Annuler" onAction="#annuler"
                    prefHeight="38" prefWidth="100"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b;
                           -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-background-radius: 10; -fx-border-color: #e2e8f0;
                           -fx-border-radius: 10; -fx-cursor: hand;"/>
            <Button text="✅  Planifier la maintenance" onAction="#ajouter"
                    prefHeight="38"
                    style="-fx-background-color: #d97706; -fx-text-fill: white;
                           -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 22;
                           -fx-effect: dropshadow(gaussian,rgba(217,119,6,0.4),10,0,0,3);"/>
        </HBox>
    </VBox>
</HBox>
