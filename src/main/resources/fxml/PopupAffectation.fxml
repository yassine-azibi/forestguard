<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.PopupAffectationController"
           prefWidth="480" prefHeight="420"
           style="-fx-background-color: #0d1f14;">

    <VBox spacing="0" style="-fx-background-color: #0d1f14;
                             -fx-border-color: #dc2626;
                             -fx-border-width: 2;
                             -fx-border-radius: 16;
                             -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, rgba(220,38,38,0.6), 20, 0, 0, 4);">

        <!-- ══ HEADER ROUGE/ORANGE ══ -->
        <VBox spacing="8" alignment="CENTER"
              style="-fx-background-color: linear-gradient(to bottom, #dc2626, #f97316);
                     -fx-padding: 24 20;
                     -fx-background-radius: 14 14 0 0;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 8, 0, 0, 2);">
            <Label text="🚨"
                   style="-fx-font-size: 48;"/>
            <Label text="NOUVELLE AFFECTATION !"
                   style="-fx-font-size: 20; -fx-font-weight: bold;
                          -fx-text-fill: white;
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 4, 0, 0, 2);"/>
            <Label text="Une nouvelle mission vous a été assignée"
                   style="-fx-font-size: 12;
                          -fx-text-fill: rgba(255,255,255,0.9);"/>
        </VBox>

        <!-- ══ INFORMATIONS ══ -->
        <VBox spacing="16" style="-fx-padding: 24 28;">

            <!-- Zone d'alerte -->
            <VBox spacing="6">
                <Label text="ZONE D'ALERTE"
                       style="-fx-font-size: 10; -fx-font-weight: bold;
                              -fx-text-fill: #4ade80;"/>
                <Label fx:id="lblZone" text="Forêt de Ain Draham"
                       style="-fx-font-size: 16; -fx-font-weight: bold;
                              -fx-text-fill: white;
                              -fx-padding: 12 16;
                              -fx-background-color: #1a2e1e;
                              -fx-background-radius: 8;
                              -fx-border-color: #2d5a37;
                              -fx-border-radius: 8;
                              -fx-border-width: 1;"/>
            </VBox>

            <!-- Type et Niveau -->
            <HBox spacing="12">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="TYPE D'ALERTE"
                           style="-fx-font-size: 10; -fx-font-weight: bold;
                                  -fx-text-fill: #4ade80;"/>
                    <Label fx:id="lblType" text="Incendie"
                           style="-fx-font-size: 14; -fx-font-weight: bold;
                                  -fx-text-fill: white;
                                  -fx-padding: 10 14;
                                  -fx-background-color: #1a2e1e;
                                  -fx-background-radius: 8;
                                  -fx-border-color: #2d5a37;
                                  -fx-border-radius: 8;
                                  -fx-border-width: 1;"/>
                </VBox>

                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="NIVEAU DE DANGER"
                           style="-fx-font-size: 10; -fx-font-weight: bold;
                                  -fx-text-fill: #4ade80;"/>
                    <Label fx:id="lblNiveau" text="Critique"
                           style="-fx-font-size: 14; -fx-font-weight: bold;
                                  -fx-text-fill: #dc2626;
                                  -fx-padding: 10 14;
                                  -fx-background-color: #1a2e1e;
                                  -fx-background-radius: 8;
                                  -fx-border-color: #dc2626;
                                  -fx-border-radius: 8;
                                  -fx-border-width: 1.5;"/>
                </VBox>
            </HBox>

            <!-- Distance -->
            <VBox spacing="6">
                <Label text="DISTANCE"
                       style="-fx-font-size: 10; -fx-font-weight: bold;
                              -fx-text-fill: #4ade80;"/>
                <Label fx:id="lblDistance" text="12.5 km"
                       style="-fx-font-size: 14;
                              -fx-text-fill: white;
                              -fx-padding: 10 14;
                              -fx-background-color: #1a2e1e;
                              -fx-background-radius: 8;
                              -fx-border-color: #2d5a37;
                              -fx-border-radius: 8;
                              -fx-border-width: 1;"/>
            </VBox>

        </VBox>

        <!-- ══ BOUTONS ══ -->
        <HBox spacing="12" alignment="CENTER"
              style="-fx-padding: 0 28 24 28;">
            <Button fx:id="btnRefuser" text="❌ REFUSER"
                    onAction="#handleRefuser"
                    prefWidth="200" prefHeight="48"
                    style="-fx-background-color: #dc2626;
                           -fx-text-fill: white; -fx-font-size: 14;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(220,38,38,0.5), 10, 0, 0, 3);"/>
            <Button fx:id="btnAccepter" text="✅ ACCEPTER"
                    onAction="#handleAccepter"
                    prefWidth="200" prefHeight="48"
                    style="-fx-background-color: #16a34a;
                           -fx-text-fill: white; -fx-font-size: 14;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(22,163,74,0.5), 10, 0, 0, 3);"/>
        </HBox>

    </VBox>
</StackPane>
