<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AjouterAnimal"
      prefWidth="520"
      style="-fx-background-color: #0d1f14;">

    <!-- ══ HEADER ══ -->
    <HBox spacing="14" alignment="CENTER_LEFT"
          style="-fx-background-color: #0891b2; -fx-padding: 20 24;">
        <ImageView fitWidth="36" fitHeight="36" preserveRatio="true">
            <image><Image url="@../image/foret_bg.jpg"/></image>
        </ImageView>
        <VBox spacing="2">
            <Label fx:id="titreLabel" text="Nouvel Animal"
                   style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Remplissez tous les champs *"
                   style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.75);"/>
        </VBox>
    </HBox>

    <!-- ══ FORMULAIRE ══ -->
    <VBox spacing="16" style="-fx-padding: 24; -fx-background-color: #0d1f14;">

        <!-- Zone + Espece -->
        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="ZONE (ID FORET) *"
                       style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #93c5fd;"/>
                <TextField fx:id="zoneField" promptText="Ex: 1"
                           prefWidth="220"
                           style="-fx-background-color: #1a2e1e; -fx-border-color: #2d5a37;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-text-fill: white; -fx-prompt-text-fill: #64748b;
                                  -fx-padding: 9 12;"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="ESPECE *"
                       style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #93c5fd;"/>
                <TextField fx:id="especeField" promptText="Ex: Lynx"
                           prefWidth="220"
                           style="-fx-background-color: #1a2e1e; -fx-border-color: #2d5a37;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-text-fill: white; -fx-prompt-text-fill: #64748b;
                                  -fx-padding: 9 12;"/>
            </VBox>
        </HBox>

        <!-- Nom Scientifique + Population -->
        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="NOM SCIENTIFIQUE *"
                       style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #93c5fd;"/>
                <TextField fx:id="nomScientifiqueField" promptText="Ex: Lynx pardinus"
                           prefWidth="220"
                           style="-fx-background-color: #1a2e1e; -fx-border-color: #2d5a37;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-text-fill: white; -fx-prompt-text-fill: #64748b;
                                  -fx-padding: 9 12;"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="POPULATION ESTIMEE *"
                       style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #93c5fd;"/>
                <TextField fx:id="populationField" promptText="Ex: 120"
                           prefWidth="220"
                           style="-fx-background-color: #1a2e1e; -fx-border-color: #2d5a37;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-text-fill: white; -fx-prompt-text-fill: #64748b;
                                  -fx-padding: 9 12;"/>
            </VBox>
        </HBox>

        <!-- Statut Protection + Derniere Observation -->
        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="STATUT PROTECTION *"
                       style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #93c5fd;"/>
                <ChoiceBox fx:id="statutCombo" prefWidth="220"
                           style="-fx-background-color: #1a2e1e; -fx-border-color: #2d5a37;
                                  -fx-border-radius: 8; -fx-background-radius: 8;"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="DERNIERE OBSERVATION *"
                       style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #93c5fd;"/>
                <DatePicker fx:id="observationPicker" prefWidth="220"
                            style="-fx-background-color: #1a2e1e; -fx-border-color: #2d5a37;
                                   -fx-border-radius: 8; -fx-background-radius: 8;"/>
            </VBox>
        </HBox>

    </VBox>

    <!-- ══ BOUTONS ══ -->
    <HBox spacing="12" alignment="CENTER_RIGHT"
          style="-fx-padding: 0 24 24 24;">
        <Button text="Annuler" onAction="#annuler"
                style="-fx-background-color: #1a2e1e; -fx-text-fill: #94a3b8;
                       -fx-font-size: 13; -fx-padding: 11 24; -fx-background-radius: 10;
                       -fx-border-color: #2d5a37; -fx-border-radius: 10; -fx-cursor: hand;"/>
        <Button text="Enregistrer" onAction="#validerEtAjouter"
                style="-fx-background-color: #0891b2; -fx-text-fill: white;
                       -fx-font-size: 13; -fx-font-weight: bold;
                       -fx-padding: 11 28; -fx-background-radius: 10; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian,rgba(8,145,178,0.5),10,0,0,3);"/>
    </HBox>

</VBox>
