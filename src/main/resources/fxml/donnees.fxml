<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ForestGuard.controllers.DonnesController"
      prefWidth="1280" prefHeight="800"
      style="-fx-background-color: #0d1f14;">

    <!-- ══════════ SIDEBAR ══════════ -->
    <VBox fx:id="sidebar" prefWidth="240"
          style="-fx-background-color: #111c14;
                 -fx-border-color: #1e3322;
                 -fx-border-width: 0 1 0 0;
                 -fx-min-width: 72;">
        <HBox spacing="12" alignment="CENTER_LEFT"
              style="-fx-padding: 24 16 20 16;">
            <ImageView fitWidth="44" fitHeight="44" preserveRatio="true">
                <image><Image url="@/logo.png"/></image>
            </ImageView>
            <VBox fx:id="logoNom" spacing="2">
                <Label text="ForestGuard"
                       style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Surveillance Intelligente"
                       style="-fx-font-size: 10; -fx-text-fill: #4ade80;"/>
            </VBox>
        </HBox>
        <Separator style="-fx-background-color: #1e3322; -fx-opacity: 0.6;"/>
        <VBox fx:id="navBox" spacing="3"
              style="-fx-padding: 16 10 0 10;" VBox.vgrow="ALWAYS">
            <Button fx:id="btnDB" prefWidth="220" prefHeight="46"
                    text="  Pompiers" onAction="#allerVersDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8;
                           -fx-font-size: 13; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 16; -fx-background-radius: 12; -fx-cursor: hand;"/>
            <Button fx:id="btnFR" prefWidth="220" prefHeight="46" text="  Forets"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8;
                           -fx-font-size: 13; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 16; -fx-background-radius: 12; -fx-cursor: hand;"/>
            <Button fx:id="btnCP" prefWidth="220" prefHeight="46" text="  Capteurs"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8;
                           -fx-font-size: 13; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 16; -fx-background-radius: 12; -fx-cursor: hand;"/>
            <Button fx:id="btnDN" prefWidth="220" prefHeight="46" text="  Donnees"
                    style="-fx-background-color: #16a34a; -fx-text-fill: white;
                           -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 10 16;
                           -fx-background-radius: 12; -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian,rgba(22,163,74,0.4),10,0,0,3);"/>
            <Button fx:id="btnAL" prefWidth="220" prefHeight="46" text="  Alertes"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8;
                           -fx-font-size: 13; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 16; -fx-background-radius: 12; -fx-cursor: hand;"/>
            <Button fx:id="btnIN" prefWidth="220" prefHeight="46" text="  Interventions"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8;
                           -fx-font-size: 13; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 16; -fx-background-radius: 12; -fx-cursor: hand;"/>
            <Button fx:id="btnUS" prefWidth="220" prefHeight="46" text="  Utilisateurs"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8;
                           -fx-font-size: 13; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 16; -fx-background-radius: 12; -fx-cursor: hand;"/>
        </VBox>
        <Region VBox.vgrow="ALWAYS"
                style="-fx-background-color: linear-gradient(to top,rgba(22,163,74,0.12),transparent);
                       -fx-min-height: 60;"/>
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 14 16; -fx-border-color: #1e3322; -fx-border-width: 1 0 0 0;">
            <Button fx:id="btnToggle" prefWidth="44" prefHeight="34"
                    text="&lt;" onAction="#toggleSidebar"
                    style="-fx-background-color: #1a2e1e; -fx-background-radius: 10;
                           -fx-border-color: #2d5a37; -fx-border-radius: 10;
                           -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-text-fill: #4ade80; -fx-cursor: hand;"/>
            <Label fx:id="lblReducer" text="Reduire"
                   style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>

    <!-- ══════════ CONTENU ══════════ -->
    <StackPane HBox.hgrow="ALWAYS">
        <ImageView fx:id="bgPage" fitWidth="1100" fitHeight="800"
                   preserveRatio="false" opacity="0.55">
            <image><Image url="@/foret_bg.jpg"/></image>
        </ImageView>
        <VBox style="-fx-background-color: rgba(5,20,8,0.30);"/>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;
                           -fx-border-color: transparent;">
            <VBox spacing="0" style="-fx-background-color: transparent;">

                <!-- ══ HEADER ══ -->
                <VBox style="-fx-padding: 36 36 28 36;" spacing="20">

                    <!-- Titre + boutons -->
                    <HBox alignment="CENTER_LEFT" spacing="18">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Gestion des Donnees"
                                   style="-fx-font-size: 30; -fx-font-weight: bold;
                                          -fx-text-fill: white;
                                          -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.6),10,0,0,3);"/>
                            <Label text="Historique et visualisation des mesures capteurs"
                                   style="-fx-font-size: 14; -fx-text-fill: rgba(255,255,255,0.6);"/>
                        </VBox>
                        <Button text="Exporter" onAction="#exporterCSV"
                                style="-fx-background-color: rgba(255,255,255,0.12);
                                       -fx-text-fill: white; -fx-font-size: 12;
                                       -fx-font-weight: bold; -fx-padding: 10 20;
                                       -fx-background-radius: 12;
                                       -fx-border-color: rgba(255,255,255,0.25);
                                       -fx-border-radius: 12; -fx-cursor: hand;"/>
                        <Button text="Rapport" onAction="#ouvrirRapportStatistique"
                                style="-fx-background-color: rgba(124,58,237,0.85);
                                       -fx-text-fill: white; -fx-font-size: 12;
                                       -fx-font-weight: bold; -fx-padding: 10 20;
                                       -fx-background-radius: 12; -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian,rgba(124,58,237,0.5),10,0,0,3);"/>
                        <Button text="+ Ajouter" onAction="#ouvrirModalAjouter"
                                style="-fx-background-color: #16a34a;
                                       -fx-text-fill: white; -fx-font-size: 12;
                                       -fx-font-weight: bold; -fx-padding: 10 22;
                                       -fx-background-radius: 12; -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian,rgba(22,163,74,0.6),14,0,0,4);"/>
                    </HBox>

                    <!-- ══ 3 COLONNES : BD + ESP32 LIVE + RECHERCHE ══ -->
                    <HBox spacing="16" alignment="TOP_LEFT">

                        <!-- Colonne gauche : cartes BD -->
                        <VBox spacing="12" prefWidth="400">
                            <HBox spacing="12">
                                <VBox fx:id="cardTemp" alignment="CENTER" spacing="6"
                                      HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: rgba(255,255,255,0.08);
                                             -fx-background-radius: 20;
                                             -fx-border-color: rgba(255,255,255,0.15);
                                             -fx-border-radius: 20; -fx-border-width: 1;
                                             -fx-padding: 20 24; -fx-cursor: hand;">
                                    <Label text="Température moy. (BD)"
                                           style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.55);"/>
                                    <Label fx:id="statTemp" text="--"
                                           style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #fca5a5;"/>
                                </VBox>
                                <VBox fx:id="cardHum" alignment="CENTER" spacing="6"
                                      HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: rgba(255,255,255,0.08);
                                             -fx-background-radius: 20;
                                             -fx-border-color: rgba(255,255,255,0.15);
                                             -fx-border-radius: 20; -fx-border-width: 1;
                                             -fx-padding: 20 24; -fx-cursor: hand;">
                                    <Label text="Humidité moy. (BD)"
                                           style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.55);"/>
                                    <Label fx:id="statHum" text="--"
                                           style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #93c5fd;"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="12">
                                <VBox fx:id="cardFumee" alignment="CENTER" spacing="6"
                                      HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: rgba(255,255,255,0.08);
                                             -fx-background-radius: 20;
                                             -fx-border-color: rgba(255,255,255,0.15);
                                             -fx-border-radius: 20; -fx-border-width: 1;
                                             -fx-padding: 20 24; -fx-cursor: hand;">
                                    <Label text="Fumée (BD)"
                                           style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.55);"/>
                                    <Label fx:id="statFumee" text="--"
                                           style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #fcd34d;"/>
                                </VBox>
                                <VBox fx:id="cardTotal" alignment="CENTER" spacing="6"
                                      HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: rgba(255,255,255,0.08);
                                             -fx-background-radius: 20;
                                             -fx-border-color: rgba(255,255,255,0.15);
                                             -fx-border-radius: 20; -fx-border-width: 1;
                                             -fx-padding: 20 24; -fx-cursor: hand;">
                                    <Label text="Total mesures (BD)"
                                           style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.55);"/>
                                    <Label fx:id="labelTotalDonnees" text="--"
                                           style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #4ade80;"/>
                                </VBox>
                            </HBox>
                            <VBox fx:id="cardIA" alignment="CENTER" spacing="6"
                                  style="-fx-background-color: rgba(239,68,68,0.15);
                                         -fx-background-radius: 20;
                                         -fx-border-color: rgba(239,68,68,0.35);
                                         -fx-border-radius: 20; -fx-border-width: 1.5;
                                         -fx-padding: 16 20; -fx-cursor: hand;">
                                <Label text="IA  Risque Incendie"
                                       style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.75);
                                              -fx-font-weight: bold;"/>
                                <Label fx:id="statIA" text="--"
                                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #fca5a5;"/>
                                <Label fx:id="statIAPct" text="0%"
                                       style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.6);"/>
                            </VBox>
                        </VBox>

                        <!-- Colonne milieu : ESP32 Live -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(10,30,15,0.75);
                                     -fx-background-radius: 20;
                                     -fx-border-color: rgba(22,163,74,0.5);
                                     -fx-border-radius: 20; -fx-border-width: 1.5;
                                     -fx-padding: 18 20;">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="LIVE"
                                       style="-fx-background-color: #16a34a; -fx-text-fill: white;
                                              -fx-font-size: 10; -fx-font-weight: bold;
                                              -fx-background-radius: 6; -fx-padding: 3 8;"/>
                                <Label text="Forêt Ain Drahem"
                                       style="-fx-font-size: 13; -fx-font-weight: bold;
                                              -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblStatutESP" text="●"
                                       style="-fx-font-size: 13; -fx-text-fill: #f59e0b;"/>
                            </HBox>
                            <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>
                            <HBox spacing="8">
                                <VBox fx:id="espCardTemp" alignment="CENTER" spacing="6"
                                      HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: rgba(239,68,68,0.2);
                                             -fx-background-radius: 14;
                                             -fx-border-color: rgba(239,68,68,0.4);
                                             -fx-border-radius: 14; -fx-border-width: 1;
                                             -fx-padding: 14 8;">
                                    <Label text="🌡 Temp"
                                           style="-fx-font-size: 10; -fx-font-weight: bold;
                                                  -fx-text-fill: rgba(255,255,255,0.7);"/>
                                    <Label fx:id="espTemp" text="--°C"
                                           style="-fx-font-size: 22; -fx-font-weight: bold;
                                                  -fx-text-fill: #fca5a5;"/>
                                </VBox>
                                <VBox fx:id="espCardHum" alignment="CENTER" spacing="6"
                                      HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: rgba(59,130,246,0.2);
                                             -fx-background-radius: 14;
                                             -fx-border-color: rgba(59,130,246,0.4);
                                             -fx-border-radius: 14; -fx-border-width: 1;
                                             -fx-padding: 14 8;">
                                    <Label text="💧 Hum"
                                           style="-fx-font-size: 10; -fx-font-weight: bold;
                                                  -fx-text-fill: rgba(255,255,255,0.7);"/>
                                    <Label fx:id="espHum" text="--%"
                                           style="-fx-font-size: 22; -fx-font-weight: bold;
                                                  -fx-text-fill: #93c5fd;"/>
                                </VBox>
                                <VBox fx:id="espCardFumee" alignment="CENTER" spacing="6"
                                      HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: rgba(234,179,8,0.2);
                                             -fx-background-radius: 14;
                                             -fx-border-color: rgba(234,179,8,0.4);
                                             -fx-border-radius: 14; -fx-border-width: 1;
                                             -fx-padding: 14 8;">
                                    <Label text="🔥 Flamme"
                                           style="-fx-font-size: 10; -fx-font-weight: bold;
                                                  -fx-text-fill: rgba(255,255,255,0.7);"/>
                                    <Label fx:id="espFumee" text="--"
                                           style="-fx-font-size: 22; -fx-font-weight: bold;
                                                  -fx-text-fill: #fcd34d;"/>
                                </VBox>
                            </HBox>
                            <Label fx:id="lblDernieredonnee" text="En attente de données..."
                                   wrapText="true"
                                   style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.45);"/>
                            <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>
                            <!-- Changer de capteur — REMPLACER le VBox existant -->
                            <VBox spacing="6">
                                <Label text="Changer de capteur"
                                       style="-fx-font-size: 10; -fx-font-weight: bold;
                  -fx-text-fill: rgba(255,255,255,0.6);"/>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <ChoiceBox fx:id="capteurESPCombo"
                                               HBox.hgrow="ALWAYS"
                                               prefHeight="34"
                                               style="-fx-background-color: rgba(255,255,255,0.12);
                          -fx-background-radius: 8;
                          -fx-border-color: rgba(255,255,255,0.25);
                          -fx-border-radius: 8;
                          -fx-mark-color: white;"/>
                                    <Button text="↺" onAction="#reconnecterESP"
                                            style="-fx-background-color: rgba(22,163,74,0.3);
                       -fx-text-fill: #4ade80; -fx-font-size: 13;
                       -fx-font-weight: bold; -fx-padding: 6 12;
                       -fx-background-radius: 8;
                       -fx-border-color: rgba(22,163,74,0.5);
                       -fx-border-radius: 8; -fx-cursor: hand;"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- Colonne droite : Recherche forêts — REMPLACER tout le VBox existant -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(10,30,15,0.75);
             -fx-background-radius: 20;
             -fx-border-color: rgba(255,255,255,0.15);
             -fx-border-radius: 20; -fx-border-width: 1;
             -fx-padding: 18 20;
             -fx-min-width: 320;">

                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="Forêts surveillées"
                                       style="-fx-font-size: 13; -fx-font-weight: bold;
                      -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
                            </HBox>

                            <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>

                            <!-- Barre recherche -->
                            <HBox spacing="0"
                                  style="-fx-background-color: rgba(255,255,255,0.1);
                 -fx-background-radius: 10;
                 -fx-border-color: rgba(255,255,255,0.2);
                 -fx-border-radius: 10; -fx-border-width: 1;">
                                <Label text="🔍"
                                       style="-fx-font-size: 12; -fx-padding: 8 8 8 12;
                      -fx-text-fill: rgba(255,255,255,0.5);"/>
                                <TextField fx:id="champRechercheForet"
                                           promptText="Chercher une forêt..."
                                           style="-fx-background-color: transparent;
                          -fx-border-color: transparent;
                          -fx-font-size: 12; -fx-text-fill: white;
                          -fx-prompt-text-fill: rgba(255,255,255,0.35);
                          -fx-padding: 8 4;"
                                           HBox.hgrow="ALWAYS"/>
                            </HBox>

                            <!-- Liste forêts — plus haute -->
                            <ListView fx:id="listeResultatsForets" prefHeight="200"
                                      style="-fx-background-color: transparent;
                     -fx-border-color: rgba(255,255,255,0.1);
                     -fx-border-radius: 10; -fx-border-width: 1;
                     -fx-background-insets: 0; -fx-padding: 4;"/>

                            <!-- Stats forêt sélectionnée — AGRANDIE -->
                            <VBox fx:id="boxForetSelectionnee" spacing="10"
                                  visible="false" managed="false"
                                  style="-fx-background-color: rgba(22,163,74,0.2);
                 -fx-background-radius: 12;
                 -fx-border-color: rgba(22,163,74,0.4);
                 -fx-border-radius: 12; -fx-border-width: 1;
                 -fx-padding: 14 16;">

                                <!-- Nom forêt -->
                                <Label fx:id="lblForetSelectNom" text=""
                                       style="-fx-font-size: 13; -fx-font-weight: bold;
                      -fx-text-fill: #4ade80;"
                                       wrapText="true"/>

                                <!-- Stats en grille -->
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <!-- Température -->
                                    <VBox spacing="4" alignment="CENTER"
                                          HBox.hgrow="ALWAYS"
                                          style="-fx-background-color: rgba(239,68,68,0.2);
                         -fx-background-radius: 10;
                         -fx-border-color: rgba(239,68,68,0.3);
                         -fx-border-radius: 10; -fx-border-width: 1;
                         -fx-padding: 10 8;">
                                        <Label text="Température"
                                               style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.6);
                              -fx-font-weight: bold;"/>
                                        <Label fx:id="lblForetSelectTemp" text="--°C"
                                               style="-fx-font-size: 18; -fx-font-weight: bold;
                              -fx-text-fill: #fca5a5;"/>
                                    </VBox>

                                    <!-- Humidité -->
                                    <VBox spacing="4" alignment="CENTER"
                                          HBox.hgrow="ALWAYS"
                                          style="-fx-background-color: rgba(59,130,246,0.2);
                         -fx-background-radius: 10;
                         -fx-border-color: rgba(59,130,246,0.3);
                         -fx-border-radius: 10; -fx-border-width: 1;
                         -fx-padding: 10 8;">
                                        <Label text="Humidité"
                                               style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.6);
                              -fx-font-weight: bold;"/>
                                        <Label fx:id="lblForetSelectHum" text="--%"
                                               style="-fx-font-size: 18; -fx-font-weight: bold;
                              -fx-text-fill: #93c5fd;"/>
                                    </VBox>

                                    <!-- Mesures -->
                                    <VBox spacing="4" alignment="CENTER"
                                          HBox.hgrow="ALWAYS"
                                          style="-fx-background-color: rgba(22,163,74,0.2);
                         -fx-background-radius: 10;
                         -fx-border-color: rgba(22,163,74,0.3);
                         -fx-border-radius: 10; -fx-border-width: 1;
                         -fx-padding: 10 8;">
                                        <Label text="Mesures"
                                               style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.6);
                              -fx-font-weight: bold;"/>
                                        <Label fx:id="lblForetSelectNb" text="--"
                                               style="-fx-font-size: 18; -fx-font-weight: bold;
                              -fx-text-fill: #4ade80;"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                        </VBox>
                    </HBox>
                    <!-- FIN 3 COLONNES -->

                    <!-- Bannière IA -->
                    <HBox fx:id="banniereIA" alignment="CENTER_LEFT" spacing="14"
                          style="-fx-background-color: rgba(239,68,68,0.12);
                                 -fx-background-radius: 14;
                                 -fx-border-color: rgba(239,68,68,0.25);
                                 -fx-border-radius: 14; -fx-border-width: 1;
                                 -fx-padding: 12 18;">
                        <Label fx:id="iaEmoji" text="!" style="-fx-font-size: 22;"/>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label fx:id="iaMessage" text="Analyse en cours..."
                                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label fx:id="iaPrediction2h" text=""
                                   style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.65);"/>
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="3">
                            <Label fx:id="iaReco" text=""
                                   style="-fx-font-size: 11; -fx-text-fill: #fcd34d; -fx-font-weight: bold;"/>
                            <ProgressBar fx:id="barreRisque" prefWidth="160" prefHeight="8"
                                         style="-fx-accent: #ef4444;
                                                -fx-background-color: rgba(255,255,255,0.15);
                                                -fx-background-radius: 4; -fx-background-insets: 0;"/>
                        </VBox>
                    </HBox>

                    <!-- Risque par forêt -->
                    <VBox style="-fx-background-color: rgba(255,255,255,0.93);
                                 -fx-background-radius: 16;
                                 -fx-border-color: rgba(255,255,255,0.98);
                                 -fx-border-radius: 16; -fx-border-width: 1;
                                 -fx-padding: 18 20;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.2),12,0,0,3);"
                          spacing="14">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="IA"
                                   style="-fx-background-color: #7c3aed; -fx-text-fill: white;
                                          -fx-font-size: 13; -fx-font-weight: bold;
                                          -fx-background-radius: 8; -fx-padding: 5 10;"/>
                            <Label text="Risque d'incendie par foret"
                                   style="-fx-font-size: 15; -fx-font-weight: bold;
