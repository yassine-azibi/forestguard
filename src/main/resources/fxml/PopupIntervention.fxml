<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.PopupInterventionController"
      prefWidth="900" prefHeight="700"
      style="-fx-background-color: #0d1f14;">

    <!-- ══ HEADER VERT ══ -->
    <HBox alignment="CENTER_LEFT" spacing="16"
          style="-fx-background-color: #16a34a;
                 -fx-padding: 18 24;">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="ForestGuard — Analyse d'Intervention"
                   style="-fx-font-size: 18; -fx-font-weight: bold;
                          -fx-text-fill: white;"/>
            <Label fx:id="lblZoneHeader"
                   text="Zone en cours d'analyse..."
                   style="-fx-font-size: 12;
                          -fx-text-fill: rgba(255,255,255,0.8);"/>
        </VBox>
        <!-- Badge risque -->
        <VBox alignment="CENTER" spacing="4"
              style="-fx-background-color: rgba(0,0,0,0.2);
                     -fx-background-radius: 12;
                     -fx-padding: 10 20;">
            <Label text="SCORE DE RISQUE"
                   style="-fx-font-size: 9; -fx-font-weight: bold;
                          -fx-text-fill: rgba(255,255,255,0.7);"/>
            <Label fx:id="lblScoreRisque" text="--"
                   style="-fx-font-size: 26; -fx-font-weight: bold;
                          -fx-text-fill: white;"/>
            <Label fx:id="lblNiveauRisque" text="Analyse..."
                   style="-fx-font-size: 11; -fx-font-weight: bold;
                          -fx-text-fill: white;"/>
        </VBox>
    </HBox>

    <!-- ══ CORPS ══ -->
    <HBox VBox.vgrow="ALWAYS" spacing="0">

        <!-- GAUCHE : Carte -->
        <VBox prefWidth="520"
              style="-fx-background-color: #0a1a0f;
             -fx-border-color: #1e3322;
             -fx-border-width: 0 1 0 0;">
            <Label text="Localisation de l'intervention"
                   style="-fx-font-size: 11; -fx-font-weight: bold;
                  -fx-text-fill: #4ade80;
                  -fx-padding: 12 16 8 16;"/>
            <ImageView fx:id="imgCarte" fitWidth="520" fitHeight="400"
                       preserveRatio="false" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #1a2e1e;"/>
        </VBox>

        <!-- DROITE : Infos -->
        <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;
                           -fx-border-color: transparent;">
            <VBox spacing="12"
                  style="-fx-padding: 16;
                         -fx-background-color: #0d1f14;">

                <!-- Météo -->
                <VBox spacing="8"
                      style="-fx-background-color: rgba(255,255,255,0.06);
                             -fx-background-radius: 14;
                             -fx-border-color: rgba(255,255,255,0.12);
                             -fx-border-radius: 14; -fx-border-width: 1;
                             -fx-padding: 14;">
                    <Label text="Conditions Meteorologiques"
                           style="-fx-font-size: 12; -fx-font-weight: bold;
                                  -fx-text-fill: #4ade80;"/>
                    <HBox spacing="8">
                        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(255,255,255,0.05);
                                     -fx-background-radius: 10;
                                     -fx-padding: 10;">
                            <Label text="🌡️" style="-fx-font-size: 18;"/>
                            <Label fx:id="lblTemperature" text="--°C"
                                   style="-fx-font-size: 16; -fx-font-weight: bold;
                                          -fx-text-fill: #fca5a5;"/>
                            <Label text="Temperature"
                                   style="-fx-font-size: 9;
                                          -fx-text-fill: rgba(255,255,255,0.5);"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(255,255,255,0.05);
                                     -fx-background-radius: 10;
                                     -fx-padding: 10;">
                            <Label text="💧" style="-fx-font-size: 18;"/>
                            <Label fx:id="lblHumidite" text="--%"
                                   style="-fx-font-size: 16; -fx-font-weight: bold;
                                          -fx-text-fill: #93c5fd;"/>
                            <Label text="Humidite"
                                   style="-fx-font-size: 9;
                                          -fx-text-fill: rgba(255,255,255,0.5);"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(255,255,255,0.05);
                                     -fx-background-radius: 10;
                                     -fx-padding: 10;">
                            <Label text="💨" style="-fx-font-size: 18;"/>
                            <Label fx:id="lblVent" text="-- km/h"
                                   style="-fx-font-size: 16; -fx-font-weight: bold;
                                          -fx-text-fill: #fcd34d;"/>
                            <Label text="Vent"
                                   style="-fx-font-size: 9;
                                          -fx-text-fill: rgba(255,255,255,0.5);"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="lblDescMeteo" text=""
                           style="-fx-font-size: 11; -fx-font-style: italic;
                                  -fx-text-fill: rgba(255,255,255,0.5);"/>
                </VBox>

                <!-- Recommandation IA -->
                <VBox spacing="6"
                      style="-fx-background-color: rgba(255,255,255,0.06);
                             -fx-background-radius: 14;
                             -fx-border-color: rgba(255,255,255,0.12);
                             -fx-border-radius: 14; -fx-border-width: 1;
                             -fx-padding: 14;">
                    <Label text="Analyse IA"
                           style="-fx-font-size: 12; -fx-font-weight: bold;
                                  -fx-text-fill: #4ade80;"/>
                    <Label fx:id="lblRecommandation" text=""
                           style="-fx-font-size: 11; -fx-text-fill: #e2e8f0;
                                  -fx-wrap-text: true;"
                           wrapText="true"/>
                </VBox>

                <!-- Durée estimée -->
                <VBox spacing="6"
                      style="-fx-background-color: rgba(255,255,255,0.06);
                             -fx-background-radius: 14;
                             -fx-border-color: rgba(255,255,255,0.12);
                             -fx-border-radius: 14; -fx-border-width: 1;
                             -fx-padding: 14;">
                    <Label text="Duree Estimee"
                           style="-fx-font-size: 12; -fx-font-weight: bold;
                                  -fx-text-fill: #4ade80;"/>
                    <Label fx:id="lblDuree" text=""
                           style="-fx-font-size: 13; -fx-font-weight: bold;
                                  -fx-text-fill: #fcd34d;"/>
                </VBox>

                <!-- Équipements suggérés -->
                <VBox spacing="6"
                      style="-fx-background-color: rgba(255,255,255,0.06);
                             -fx-background-radius: 14;
                             -fx-border-color: rgba(255,255,255,0.12);
                             -fx-border-radius: 14; -fx-border-width: 1;
                             -fx-padding: 14;">
                    <Label text="Equipements Suggeres"
                           style="-fx-font-size: 12; -fx-font-weight: bold;
                                  -fx-text-fill: #4ade80;"/>
                    <VBox fx:id="vboxEquipements" spacing="4"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </HBox>

    <!-- ══ FOOTER ══ -->
    <HBox alignment="CENTER_RIGHT" spacing="12"
          style="-fx-padding: 14 24;
                 -fx-background-color: #0a1a0f;
                 -fx-border-color: #1e3322;
                 -fx-border-width: 1 0 0 0;">
        <Label fx:id="lblStatutMeteo"
               text="Donnees en temps reel"
               style="-fx-font-size: 10; -fx-text-fill: #4ade80;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Fermer"
                onAction="#handleFermer"
                style="-fx-background-color: #1a2e1e;
                       -fx-text-fill: #94a3b8; -fx-font-size: 13;
                       -fx-padding: 10 24; -fx-background-radius: 10;
                       -fx-border-color: #2d5a37; -fx-border-radius: 10;
                       -fx-cursor: hand;"/>
    </HBox>

</VBox>