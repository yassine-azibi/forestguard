<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.forestguard.controllers.AdminUtilisateurController"
           styleClass="admin-root"
           stylesheets="@../styles/app.css">

    <!-- Background image -->
    <ImageView fx:id="backgroundImage" preserveRatio="false" opacity="0.55"
               StackPane.alignment="CENTER">
        <image>
            <Image url="@../images/foret.jpg"/>
        </image>
    </ImageView>
    <VBox styleClass="admin-overlay"/>

    <!-- Main layout -->
    <BorderPane>

        <!-- ═══ TOOLBAR ═══ -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="toolbar-shell">
                <padding>
                    <Insets top="14" right="24" bottom="14" left="24"/>
                </padding>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <ImageView fitWidth="40" fitHeight="40" preserveRatio="true">
                        <image>
                            <Image url="@../images/logo.png"/>
                        </image>
                    </ImageView>
                    <VBox spacing="2">
                        <Label text="ForestGuard" styleClass="toolbar-brand"/>
                        <Label text="Administration — Gestion des utilisateurs" styleClass="toolbar-subbrand"/>
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="🏠 Dashboard" styleClass="nav-pill"
                            onAction="#handleBackToDashboard"/>
                    <Button text="🔄 Actualiser" styleClass="nav-pill"
                            onAction="#handleRefresh"/>
                    <Button text="🚪 Déconnexion" styleClass="nav-pill"
                            onAction="#handleLogout"/>
                    <Label fx:id="navAvatarLabel" text="AD"
                           styleClass="nav-avatar-circle"/>
                </HBox>
            </HBox>
        </top>

        <!-- ═══ CONTENT ═══ -->
        <center>
            <ScrollPane fitToWidth="true" styleClass="content-scroll">
                <VBox spacing="20" styleClass="admin-page">
                    <padding>
                        <Insets top="24" right="28" bottom="28" left="28"/>
                    </padding>

                    <!-- Page title + Add button -->
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label text="👥 Gestion des Utilisateurs" styleClass="hero-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="➕ Ajouter un utilisateur"
                                styleClass="primary-button"
                                onAction="#handleAddUser"/>
                    </HBox>

                    <!-- Stats cards -->
                    <HBox spacing="16">
                        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS"
                              alignment="CENTER" spacing="6">
                            <Label text="👤 Total utilisateurs" styleClass="stat-label"/>
                            <Label fx:id="totalUsersLabel" text="—" styleClass="stat-value"/>
                        </VBox>
                        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS"
                              alignment="CENTER" spacing="6">
                            <Label text="🔵 Comptes Google" styleClass="stat-label"/>
                            <Label fx:id="googleUsersLabel" text="—" styleClass="stat-value"/>
                        </VBox>
                        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS"
                              alignment="CENTER" spacing="6">
                            <Label text="🔑 Comptes classiques" styleClass="stat-label"/>
                            <Label fx:id="classicUsersLabel" text="—" styleClass="stat-value"/>
                        </VBox>
                        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS"
                              alignment="CENTER" spacing="6">
                            <Label text="📍 Gouvernorats représentés" styleClass="stat-label"/>
                            <Label fx:id="governoratesLabel" text="—" styleClass="stat-value"/>
                        </VBox>
                    </HBox>

                    <!-- Filters -->
                    <HBox spacing="14" alignment="CENTER_LEFT" styleClass="admin-filter-bar">
                        <padding>
                            <Insets top="14" right="18" bottom="14" left="18"/>
                        </padding>
                        <Label text="🔍" style="-fx-font-size: 16px;"/>
                        <TextField fx:id="searchField"
                                   promptText="Rechercher par nom, email, téléphone..."
                                   HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label text="📍" style="-fx-font-size: 16px;"/>
                        <ComboBox fx:id="filterGovCombo"
                                  promptText="Gouvernorat" prefWidth="200"/>
                        <Button fx:id="resetFilterButton"
                                text="✖ Réinitialiser"
                                styleClass="secondary-button"
                                onAction="#handleResetFilters"/>
                    </HBox>

                    <!-- Table -->
                    <VBox styleClass="admin-table-card" spacing="0">
                        <TableView fx:id="tableView" styleClass="admin-table"
                                   VBox.vgrow="ALWAYS" minHeight="380">
                            <columns>
                                <TableColumn fx:id="colId"           text="ID"
                                             prefWidth="55"  minWidth="45"/>
                                <TableColumn fx:id="colNom"          text="Nom"
                                             prefWidth="160" minWidth="100"/>
                                <TableColumn fx:id="colEmail"        text="Email"
                                             prefWidth="220" minWidth="140"/>
                                <TableColumn fx:id="colTelephone"    text="Téléphone"
                                             prefWidth="150" minWidth="110"/>
                                <TableColumn fx:id="colLocalisation" text="Gouvernorat"
                                             prefWidth="130" minWidth="90"/>
                                <TableColumn fx:id="colType"         text="Type"
                                             prefWidth="120" minWidth="90"/>
                                <TableColumn fx:id="colActions"      text="Actions"
                                             prefWidth="200" minWidth="160"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>

                        <!-- Pagination -->
                        <HBox alignment="CENTER" spacing="14" styleClass="admin-pagination">
                            <padding>
                                <Insets top="12" right="18" bottom="12" left="18"/>
                            </padding>
                            <Button fx:id="prevPageButton" text="◀ Précédent"
                                    styleClass="secondary-button"
                                    onAction="#handlePrevPage"/>
                            <Label fx:id="pageInfoLabel" text="Page 1 / 1"
                                   styleClass="admin-page-info"/>
                            <Button fx:id="nextPageButton" text="Suivant ▶"
                                    styleClass="secondary-button"
                                    onAction="#handleNextPage"/>
                        </HBox>
                    </VBox>

                    <!-- Feedback -->
                    <Label fx:id="feedbackLabel" text="" wrapText="true"
                           style="-fx-font-size: 13px; -fx-font-weight: 600;"/>

                </VBox>
            </ScrollPane>
        </center>

    </BorderPane>
</StackPane>
