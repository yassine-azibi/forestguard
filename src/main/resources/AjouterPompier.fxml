<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.pompier.controllers.AjouterPompierController"
            prefHeight="780.0" prefWidth="480.0"
            style="-fx-background-color: #f4f6f4;">

    <!-- HEADER VERT -->
    <HBox AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          prefHeight="88" alignment="CENTER_LEFT" spacing="16"
          style="-fx-background-color: #22c55e; -fx-padding: 18 28;">
        <Label text="&#128101;" style="-fx-font-size: 30;"/>
        <VBox spacing="3">
            <Label text="Nouveau Pompier"
                   style="-fx-text-fill: white; -fx-font-size: 19; -fx-font-weight: bold;"/>
            <Label text="Remplissez tous les champs obligatoires *"
                   style="-fx-text-fill: rgba(255,255,255,0.78); -fx-font-size: 11;"/>
        </VBox>
    </HBox>

    <!-- CORPS -->
    <ScrollPane fitToWidth="true"
                AnchorPane.topAnchor="88" AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0"
                style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">

        <VBox spacing="16" style="-fx-padding: 26 26 26 26; -fx-background-color: #f4f6f4;">

            <!-- NOM / PRENOM -->
            <HBox spacing="14">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="NOM *" style="-fx-text-fill: #374151; -fx-font-size: 10; -fx-font-weight: bold;"/>
                    <TextField fx:id="tfNom" promptText="Ex: Dupont"
                               style="-fx-background-color: #ffffff; -fx-text-fill: #111827; -fx-prompt-text-fill: #9ca3af; -fx-background-radius: 10; -fx-border-color: #d1d5db; -fx-border-radius: 10; -fx-padding: 10 13; -fx-font-size: 13;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="PRENOM *" style="-fx-text-fill: #374151; -fx-font-size: 10; -fx-font-weight: bold;"/>
                    <TextField fx:id="tfPrenom" promptText="Ex: Jean"
                               style="-fx-background-color: #ffffff; -fx-text-fill: #111827; -fx-prompt-text-fill: #9ca3af; -fx-background-radius: 10; -fx-border-color: #d1d5db; -fx-border-radius: 10; -fx-padding: 10 13; -fx-font-size: 13;"/>
                </VBox>
            </HBox>

            <!-- EMAIL -->
            <VBox spacing="6">
                <Label text="EMAIL *" style="-fx-text-fill: #374151; -fx-font-size: 10; -fx-font-weight: bold;"/>
                <TextField fx:id="tfEmail" promptText="Ex: jean.dupont@gmail.com"
                           style="-fx-background-color: #ffffff; -fx-text-fill: #111827; -fx-prompt-text-fill: #9ca3af; -fx-background-radius: 10; -fx-border-color: #d1d5db; -fx-border-radius: 10; -fx-padding: 10 13; -fx-font-size: 13;"/>
                <Label fx:id="lblStatutMail" text=""
                       style="-fx-font-size: 11; -fx-text-fill: #16a34a;" wrapText="true"/>
            </VBox>

            <!-- TELEPHONE / MOT DE PASSE -->
            <HBox spacing="14">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="TELEPHONE" style="-fx-text-fill: #374151; -fx-font-size: 10; -fx-font-weight: bold;"/>
                    <TextField fx:id="tfTelephone" promptText="Ex: 0612345678"
                               style="-fx-background-color: #ffffff; -fx-text-fill: #111827; -fx-prompt-text-fill: #9ca3af; -fx-background-radius: 10; -fx-border-color: #d1d5db; -fx-border-radius: 10; -fx-padding: 10 13; -fx-font-size: 13;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="MOT DE PASSE *" style="-fx-text-fill: #374151; -fx-font-size: 10; -fx-font-weight: bold;"/>
                    <PasswordField fx:id="tfMotDePasse" promptText="Mot de passe"
                                   style="-fx-background-color: #ffffff; -fx-text-fill: #111827; -fx-prompt-text-fill: #9ca3af; -fx-background-radius: 10; -fx-border-color: #d1d5db; -fx-border-radius: 10; -fx-padding: 10 13; -fx-font-size: 13;"/>
                </VBox>
            </HBox>

            <!-- STATUT / FORET -->
            <HBox spacing="14">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="STATUT *" style="-fx-text-fill: #374151; -fx-font-size: 10; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="cbStatut" maxWidth="Infinity"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-color: #d1d5db; -fx-border-radius: 10; -fx-font-size: 13;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="FORET (ZONE)" style="-fx-text-fill: #374151; -fx-font-size: 10; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="cbForet" maxWidth="Infinity" promptText="Selectionner une foret"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-color: #d1d5db; -fx-border-radius: 10; -fx-font-size: 13;"/>
                </VBox>
            </HBox>

            <!-- CERTIFICATION -->
            <VBox spacing="6">
                <Label text="NIVEAU DE CERTIFICATION" style="-fx-text-fill: #374151; -fx-font-size: 10; -fx-font-weight: bold;"/>
                <ComboBox fx:id="cbNiveauCertif" maxWidth="Infinity" promptText="Selectionner un niveau"
                          style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-color: #d1d5db; -fx-border-radius: 10; -fx-font-size: 13;"/>
            </VBox>

            <!-- ══════════════════════════════════════════ -->
            <!-- LOCALISATION DU POMPIER (NOUVEAU BLOC)    -->
            <!-- ══════════════════════════════════════════ -->
            <VBox spacing="0">
                <!-- Séparateur titre -->
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 4 0 10 0;">
                    <Label text="&#128205;" style="-fx-font-size: 14;"/>
                    <Label text="LOCALISATION DU POMPIER"
                           style="-fx-text-fill: #16a34a; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Pour le calcul de distance"
                           style="-fx-text-fill: #6b7280; -fx-font-size: 10;"/>
                </HBox>

                <VBox spacing="12" style="-fx-background-color: #f9fafb; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-padding: 14 14 14 14;">

                    <!-- VILLE -->
                    <VBox spacing="6">
                        <Label text="VILLE *" style="-fx-text-fill: #374151; -fx-font-size: 10; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="cbVille" maxWidth="Infinity"
                                  promptText="Selectionner la ville du pompier"
                                  style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-color: #d1d5db; -fx-border-radius: 10; -fx-font-size: 13;"/>
                    </VBox>

                    <!-- ZONE -->
                    <VBox spacing="6">
                        <Label text="ZONE / QUARTIER *" style="-fx-text-fill: #374151; -fx-font-size: 10; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="cbZone" maxWidth="Infinity"
                                  promptText="Selectionner la zone"
                                  style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-color: #d1d5db; -fx-border-radius: 10; -fx-font-size: 13;"/>
                    </VBox>

                    <!-- Info coordonnées auto -->
                    <HBox spacing="8" alignment="CENTER_LEFT"
                          style="-fx-background-color: #f0fdf4; -fx-background-radius: 8; -fx-padding: 8 12; -fx-border-color: #bbf7d0; -fx-border-radius: 8; -fx-border-width: 1;">
                        <Label text="&#128204;" style="-fx-font-size: 13;"/>
                        <Label fx:id="lblCoordonnees" text="Les coordonnees GPS seront calculees automatiquement"
                               wrapText="true" HBox.hgrow="ALWAYS"
                               style="-fx-text-fill: #16a34a; -fx-font-size: 11;"/>
                    </HBox>

                </VBox>
            </VBox>

            <!-- PHOTO DU POMPIER -->
            <VBox spacing="6">
                <Label text="PHOTO DU POMPIER" style="-fx-text-fill: #374151; -fx-font-size: 10; -fx-font-weight: bold;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ImageView fx:id="imgPreviewAjouter" fitWidth="64" fitHeight="64" preserveRatio="true"/>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Button text="&#128247;  Choisir une photo" onAction="#choisirPhoto"
                                style="-fx-background-color: #f0fdf4; -fx-text-fill: #16a34a; -fx-font-size: 12; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-color: #86efac; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 8 16; -fx-cursor: hand;"/>
                        <Label fx:id="lblPhotoPath" text="Aucune photo selectionnee"
                               style="-fx-text-fill: #9ca3af; -fx-font-size: 10; -fx-font-style: italic;" wrapText="true"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Bannière info email -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color: #f0fdf4; -fx-background-radius: 10; -fx-border-color: #bbf7d0; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 10 14;">
                <Label text="&#128231;" style="-fx-font-size: 16;"/>
                <Label text="Un email de bienvenue sera envoye automatiquement au pompier apres l'enregistrement."
                       wrapText="true" HBox.hgrow="ALWAYS"
                       style="-fx-text-fill: #16a34a; -fx-font-size: 11;"/>
            </HBox>

            <!-- BOUTONS -->
            <HBox spacing="14" style="-fx-padding: 6 0 0 0;">
                <Button text="Annuler" prefWidth="188" prefHeight="44"
                        onAction="#fermerFenetre"
                        style="-fx-background-color: #ffffff; -fx-text-fill: #374151; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 12; -fx-border-color: #d1d5db; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-cursor: hand;"/>
                <Button text="&#10003;  Enregistrer" prefWidth="214" prefHeight="44"
                        onAction="#sauvegarder"
                        style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian,rgba(34,197,94,0.5),14,0,0,4);"/>
            </HBox>

        </VBox>
    </ScrollPane>
</AnchorPane>
