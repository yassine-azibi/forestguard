<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ForestGuard.controllers.RapportStatistiqueController"
      prefWidth="860"
      style="-fx-background-color: white; -fx-background-radius: 14;">

    <!-- ══ HEADER ══ -->
    <HBox spacing="14" alignment="CENTER_LEFT"
          style="-fx-background-color: #15803d;
                 -fx-padding: 20 26;
                 -fx-background-radius: 14 14 0 0;">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Rapport Statistique d'Incendie"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Analyse du risque par forêt et par période"
                   style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.75);"/>
        </VBox>
        <Label fx:id="lblStatutSauvegarde" text=""
               style="-fx-font-size: 11; -fx-text-fill: #bbf7d0; -fx-font-weight: bold;"/>
    </HBox>

    <ScrollPane fitToWidth="true"
                style="-fx-background-color: white; -fx-background: white;
                       -fx-border-color: transparent;">
        <VBox spacing="20" style="-fx-padding: 24 28;">

            <!-- ══ FORMULAIRE DE SAISIE ══ -->
            <VBox spacing="14"
                  style="-fx-background-color: #f8fafc;
                         -fx-background-radius: 14;
                         -fx-border-color: #e2e8f0;
                         -fx-border-radius: 14; -fx-border-width: 1;
                         -fx-padding: 20 22;">
                <Label text="Paramètres du rapport"
                       style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <!-- Forêt -->
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="FORÊT *"
                               style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                        <ComboBox fx:id="comboForet" prefWidth="260"
                                  promptText="Choisir une forêt..."
                                  style="-fx-background-color: white;
                                         -fx-border-color: #cbd5e1;
                                         -fx-border-radius: 8; -fx-background-radius: 8;
                                         -fx-font-size: 13;"/>
                        <Label fx:id="errForet" text=""
                               style="-fx-font-size: 10; -fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
                    </VBox>
                    <!-- Mois -->
                    <VBox spacing="6">
                        <Label text="MOIS *"
                               style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                        <ComboBox fx:id="comboMois" prefWidth="160"
                                  style="-fx-background-color: white;
                                         -fx-border-color: #cbd5e1;
                                         -fx-border-radius: 8; -fx-background-radius: 8;
                                         -fx-font-size: 13;"/>
                        <Label fx:id="errMois" text=""
                               style="-fx-font-size: 10; -fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
                    </VBox>
                    <!-- Année -->
                    <VBox spacing="6">
                        <Label text="ANNÉE *"
                               style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                        <ComboBox fx:id="comboAnnee" prefWidth="120"
                                  style="-fx-background-color: white;
                                         -fx-border-color: #cbd5e1;
                                         -fx-border-radius: 8; -fx-background-radius: 8;
                                         -fx-font-size: 13;"/>
                        <Label fx:id="errAnnee" text=""
                               style="-fx-font-size: 10; -fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
                    </VBox>
                    <!-- Bouton -->
                    <VBox spacing="6" alignment="BOTTOM_LEFT">
                        <Label text=" " style="-fx-font-size: 10;"/>
                        <Button fx:id="btnCalculer" text="Calculer le rapport"
                                onAction="#calculerRapport"
                                style="-fx-background-color: #15803d;
                                       -fx-text-fill: white; -fx-font-size: 13;
                                       -fx-font-weight: bold; -fx-padding: 11 24;
                                       -fx-background-radius: 10; -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian,rgba(21,128,61,0.4),10,0,0,3);"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ══ RÉSULTATS (cachés jusqu'au calcul) ══ -->
            <VBox fx:id="panneauResultats" spacing="18" visible="false" managed="false">

                <!-- Titre résultat -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="lblTitreResultat" text=""
                           style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #0f172a;"
                           HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblDateCalcul" text=""
                           style="-fx-font-size: 10; -fx-text-fill: #94a3b8;"/>
                </HBox>

                <!-- ══ CARTES STATS ══ -->
                <HBox spacing="14">
                    <!-- Risque global -->
                    <VBox fx:id="carteRisque" alignment="CENTER" spacing="6"
                          HBox.hgrow="ALWAYS"
                          style="-fx-background-radius: 16; -fx-border-radius: 16;
                                 -fx-border-width: 2; -fx-padding: 18 20; -fx-cursor: default;">
                        <Label text="RISQUE GLOBAL"
                               style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                        <Label fx:id="lblPourcentage" text="--"
                               style="-fx-font-size: 32; -fx-font-weight: bold;"/>
                        <Label fx:id="lblNiveauRisque" text="--"
                               style="-fx-font-size: 13; -fx-font-weight: bold;
                                      -fx-background-radius: 20; -fx-padding: 4 14;"/>
                    </VBox>
                    <!-- Danger -->
                    <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #fff1f2; -fx-background-radius: 16;
                                 -fx-border-color: #fecdd3; -fx-border-radius: 16;
                                 -fx-border-width: 1; -fx-padding: 18 20;">
                        <Label text="DANGER"
                               style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                        <Label fx:id="lblNbDanger" text="--"
                               style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                        <Label text="mesures"
                               style="-fx-font-size: 10; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                    <!-- Attention -->
                    <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #fff7ed; -fx-background-radius: 16;
                                 -fx-border-color: #fed7aa; -fx-border-radius: 16;
                                 -fx-border-width: 1; -fx-padding: 18 20;">
                        <Label text="ATTENTION"
                               style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #f97316;"/>
                        <Label fx:id="lblNbAttention" text="--"
                               style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #f97316;"/>
                        <Label text="mesures"
                               style="-fx-font-size: 10; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                    <!-- Sûr -->
                    <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #f0fdf4; -fx-background-radius: 16;
                                 -fx-border-color: #bbf7d0; -fx-border-radius: 16;
                                 -fx-border-width: 1; -fx-padding: 18 20;">
                        <Label text="SÛR"
                               style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                        <Label fx:id="lblNbSur" text="--"
                               style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                        <Label text="mesures"
                               style="-fx-font-size: 10; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                </HBox>

                <!-- ══ MOYENNES ══ -->
                <HBox spacing="14">
                    <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #fef2f2; -fx-background-radius: 12;
                                 -fx-border-color: #fecaca; -fx-border-radius: 12;
                                 -fx-border-width: 1; -fx-padding: 14 18;">
                        <Label text="TEMPÉRATURE MOY."
                               style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                        <Label fx:id="lblTempMoy" text="--"
                               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #ef4444;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #eff6ff; -fx-background-radius: 12;
                                 -fx-border-color: #bfdbfe; -fx-border-radius: 12;
                                 -fx-border-width: 1; -fx-padding: 14 18;">
                        <Label text="HUMIDITÉ MOY."
                               style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                        <Label fx:id="lblHumMoy" text="--"
                               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #fefce8; -fx-background-radius: 12;
                                 -fx-border-color: #fef08a; -fx-border-radius: 12;
                                 -fx-border-width: 1; -fx-padding: 14 18;">
                        <Label text="FUMÉE MOY."
                               style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                        <Label fx:id="lblFumeeMoy" text="--"
                               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #ca8a04;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #f5f3ff; -fx-background-radius: 12;
                                 -fx-border-color: #ddd6fe; -fx-border-radius: 12;
                                 -fx-border-width: 1; -fx-padding: 14 18;">
                        <Label text="TOTAL MESURES"
                               style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                        <Label fx:id="lblTotalMesures" text="--"
                               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #7c3aed;"/>
                    </VBox>
                </HBox>

                <!-- ══ GRAPHIQUE ÉVOLUTION ══ -->
                <VBox spacing="10"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-border-color: #e2e8f0; -fx-border-radius: 16;
                             -fx-border-width: 1; -fx-padding: 18 20;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.08),10,0,0,3);">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Évolution du risque sur le mois"
                               style="-fx-font-size: 13; -fx-font-weight: bold;
                                      -fx-text-fill: #0f172a;" HBox.hgrow="ALWAYS"/>
                        <Label text="Score 0–100"
                               style="-fx-font-size: 10; -fx-text-fill: #94a3b8;"/>
                    </HBox>
                    <BarChart fx:id="chartRisque" prefHeight="240"
                              legendVisible="false"
                              style="-fx-background-color: transparent; -fx-padding: 0;">
                        <xAxis>
                            <CategoryAxis label="Jour du mois"
                                          style="-fx-tick-label-fill: #64748b; -fx-font-size: 10;"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis lowerBound="0" upperBound="100" tickUnit="20"
                                        label="Score risque"
                                        style="-fx-tick-label-fill: #64748b; -fx-font-size: 10;"/>
                        </yAxis>
                    </BarChart>
                </VBox>

                <!-- ══ BOUTONS ACTIONS ══ -->
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button text="Historique" onAction="#afficherHistorique"
                            style="-fx-background-color: #f1f5f9;
                                   -fx-text-fill: #374151; -fx-font-size: 12;
                                   -fx-font-weight: bold; -fx-padding: 10 22;
                                   -fx-background-radius: 10;
                                   -fx-border-color: #e2e8f0; -fx-border-radius: 10;
                                   -fx-cursor: hand;"/>
                    <Button text="Exporter PDF" onAction="#exporterPDF"
                            style="-fx-background-color: #ef4444;
                                   -fx-text-fill: white; -fx-font-size: 12;
                                   -fx-font-weight: bold; -fx-padding: 10 22;
                                   -fx-background-radius: 10; -fx-cursor: hand;"/>
                    <Button text="Fermer" onAction="#fermer"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #374151; -fx-font-size: 12;
                                   -fx-padding: 10 22; -fx-background-radius: 10;
                                   -fx-border-color: #d1d5db; -fx-border-radius: 10;
                                   -fx-cursor: hand;"/>
                </HBox>

                <!-- ══ HISTORIQUE (caché par défaut) ══ -->
                <VBox fx:id="panneauHistorique" spacing="10"
                      visible="false" managed="false">
                    <Label text="Historique des rapports"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <ListView fx:id="listeHistorique" prefHeight="200"
                              style="-fx-background-color: #f8fafc;
                                     -fx-border-color: #e2e8f0;
                                     -fx-border-radius: 10; -fx-background-radius: 10;
                                     -fx-background-insets: 0; -fx-padding: 4;"/>
                </VBox>

            </VBox>

            <!-- Message si aucune donnée -->
            <VBox fx:id="panneauVide" spacing="10" alignment="CENTER"
                  visible="false" managed="false"
                  style="-fx-padding: 30 0;">
                <Label text="Aucune donnée disponible"
                       style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                <Label fx:id="lblMessageVide" text=""
                       style="-fx-font-size: 12; -fx-text-fill: #cbd5e1;"/>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
