<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.AssistantIAController"
           prefWidth="700" prefHeight="650">

    <!-- Background Image avec overlay -->
    <StackPane>
        <ImageView fitWidth="700" fitHeight="650" preserveRatio="false">
            <image>
                <javafx.scene.image.Image url="@../image/foret-back.jpg"/>
            </image>
        </ImageView>
        <!-- Overlay sombre pour la lisibilité -->
        <VBox style="-fx-background-color: rgba(5, 20, 8, 0.88);"/>
    </StackPane>

    <!-- Contenu principal -->
    <VBox style="-fx-background-color: transparent;">

        <!-- ══ HEADER AVEC LOGO ══ -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: rgba(26, 46, 30, 0.95);
                     -fx-padding: 16 20;
                     -fx-border-color: #1e3322;
                     -fx-border-width: 0 0 1 0;">
            <!-- Logo -->
            <Label text="🌲" style="-fx-font-size: 28;"/>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="🤖 Assistant IA — ForestGuard"
                       style="-fx-font-size: 16; -fx-font-weight: bold;
                              -fx-text-fill: white;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 4, 0, 0, 1);"/>
                <Label text="Conseils tactiques  •  Analyse de risque  •  Protocoles"
                       style="-fx-font-size: 10;
                              -fx-text-fill: rgba(255,255,255,0.75);"/>
            </VBox>
            <Label fx:id="lblStatutIA" text="● En ligne"
                   style="-fx-font-size: 11; -fx-font-weight: bold;
                          -fx-text-fill: #4ade80;"/>
        </HBox>

        <!-- ══ BOUTONS RAPIDES ══ -->
        <HBox spacing="8"
              style="-fx-padding: 12 16;
                     -fx-background-color: rgba(17, 28, 20, 0.8);">
            <Label text="Accès rapide :"
                   style="-fx-font-size: 11; -fx-text-fill: #94a3b8;"/>
            <Button text="🔥 Risque actuel"
                    onAction="#handleRisqueActuel"
                    style="-fx-background-color: rgba(220,38,38,0.15);
                           -fx-text-fill: #fca5a5; -fx-font-size: 11;
                           -fx-padding: 5 12; -fx-background-radius: 20;
                           -fx-border-color: rgba(220,38,38,0.3);
                       -fx-border-radius: 20; -fx-cursor: hand;"/>
        <Button text="🚁 Équipements"
                onAction="#handleEquipements"
                style="-fx-background-color: rgba(37,99,235,0.15);
                       -fx-text-fill: #93c5fd; -fx-font-size: 11;
                       -fx-padding: 5 12; -fx-background-radius: 20;
                       -fx-border-color: rgba(37,99,235,0.3);
                       -fx-border-radius: 20; -fx-cursor: hand;"/>
        <Button text="🛡️ Protocoles"
                onAction="#handleProtocoles"
                style="-fx-background-color: rgba(22,163,74,0.15);
                       -fx-text-fill: #4ade80; -fx-font-size: 11;
                       -fx-padding: 5 12; -fx-background-radius: 20;
                       -fx-border-color: rgba(22,163,74,0.3);
                       -fx-border-radius: 20; -fx-cursor: hand;"/>
        <Button text="📊 Mes stats"
                onAction="#handleMesStats"
                style="-fx-background-color: rgba(124,58,237,0.15);
                       -fx-text-fill: #c4b5fd; -fx-font-size: 11;
                       -fx-padding: 5 12; -fx-background-radius: 20;
                       -fx-border-color: rgba(124,58,237,0.3);
                       -fx-border-radius: 20; -fx-cursor: hand;"/>
    </HBox>

    <!-- ══ ZONE MESSAGES ══ -->
    <ScrollPane fx:id="scrollMessages" fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent;
                       -fx-background: transparent;
                       -fx-border-color: transparent;">
        <VBox fx:id="vboxMessages" spacing="12"
              style="-fx-padding: 16;
                     -fx-background-color: n;"/>
    </ScrollPane>

    <!-- ══ INDICATEUR CHARGEMENT ══ -->
    <HBox fx:id="hboxLoading" alignment="CENTER_LEFT" spacing="10"
          style="-fx-padding: 8 16;
                 -fx-background-color: #0a1a0f;"
          visible="false" managed="false">
        <ProgressIndicator prefWidth="20" prefHeight="20"
                           style="-fx-accent: #7c3aed;"/>
        <Label text="L'assistant analyse votre question..."
               style="-fx-font-size: 11; -fx-text-fill: #94a3b8;
                      -fx-font-style: italic;"/>
    </HBox>

    <!-- ══ ZONE SAISIE ══ -->
    <HBox spacing="10"
          style="-fx-padding: 14 16;
                 -fx-background-color: #0a1a0f;
                 -fx-border-color: #1e3322;
                 -fx-border-width: 1 0 0 0;">
        <TextField fx:id="tfMessage"
                   promptText="Posez votre question à l'assistant..."
                   HBox.hgrow="ALWAYS"
                   onAction="#handleEnvoyer"
                   style="-fx-background-color: #1a2e1e;
                          -fx-border-color: #2d5a37;
                          -fx-border-radius: 20;
                          -fx-background-radius: 20;
                          -fx-text-fill: white;
                          -fx-prompt-text-fill: #64748b;
                          -fx-padding: 10 16;
                          -fx-font-size: 13;"/>
        <Button text="Envoyer ➤"
                onAction="#handleEnvoyer"
                style="-fx-background-color: #668a67;
                       -fx-text-fill: white; -fx-font-size: 13;
                       -fx-font-weight: bold;
                       -fx-padding: 10 20; -fx-background-radius: 20;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian,rgba(124,58,237,0.5),10,0,0,3);"/>
    </HBox>

    </VBox>
</StackPane>