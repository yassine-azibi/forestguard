<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.effect.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.pompier.controllers.GestionGardesController"
      prefWidth="1100" prefHeight="750"
      style="-fx-background-color: #0d1f14;">

    <!-- ══════════ PANNEAU GAUCHE — POMPIERS ══════════ -->
    <StackPane prefWidth="520" HBox.hgrow="ALWAYS">

        <ImageView fitWidth="520" fitHeight="750"
                   preserveRatio="false" opacity="0.35">
            <image><Image url="@foret.png"/></image>
            <effect><GaussianBlur radius="2"/></effect>
        </ImageView>

        <VBox style="-fx-background-color: rgba(5,20,8,0.65);"/>

        <VBox spacing="16" style="-fx-padding: 30 24 24 24;">

            <!-- Header gauche -->
            <VBox spacing="6">
                <Label text="Pompiers"
                       style="-fx-font-size: 24; -fx-font-weight: bold;
                              -fx-text-fill: white;
                              -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.6),8,0,0,2);"/>
                <Label text="Selectionnez un pompier pour lui assigner une garde"
                       style="-fx-font-size: 12; -fx-text-fill: rgba(255,255,255,0.6);"/>
            </VBox>

            <!-- Recherche -->
            <VBox style="-fx-background-color: rgba(255,255,255,0.93);
                         -fx-background-radius: 14;
                         -fx-padding: 14 16;"
                  spacing="8">
                <Label text="Rechercher un pompier"
                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <TextField fx:id="tfRecherchePompier"
                           promptText="Nom, prenom ou telephone..."
                           style="-fx-background-radius: 8; -fx-border-radius: 8;
                                  -fx-border-color: #e2e8f0;
                                  -fx-padding: 8 12; -fx-font-size: 13;"/>
            </VBox>

            <!-- Liste pompiers -->
            <VBox VBox.vgrow="ALWAYS"
                  style="-fx-background-color: rgba(255,255,255,0.93);
                         -fx-background-radius: 14;" spacing="0">
                <HBox style="-fx-padding: 10 14;
                             -fx-background-color: rgba(248,250,252,0.98);
                             -fx-background-radius: 14 14 0 0;
                             -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                    <Label text="Nom" prefWidth="200"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                    <Label text="Telephone" prefWidth="140"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                    <Label text="Statut"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                </HBox>
                <ListView fx:id="listPompiers" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: transparent;
                                 -fx-border-color: transparent;
                                 -fx-padding: 0;"/>
            </VBox>

        </VBox>
    </StackPane>

    <!-- Séparateur vertical -->
    <Separator orientation="VERTICAL"
               style="-fx-background-color: #1e3322; -fx-opacity: 0.8;"/>

    <!-- ══════════ PANNEAU DROIT — GARDES ══════════ -->
    <StackPane prefWidth="560" HBox.hgrow="ALWAYS">

        <ImageView fitWidth="560" fitHeight="750"
                   preserveRatio="false" opacity="0.35">
            <image><Image url="@foret.png"/></image>
            <effect><GaussianBlur radius="2"/></effect>
        </ImageView>

        <VBox style="-fx-background-color: rgba(5,20,8,0.65);"/>

        <VBox spacing="16" style="-fx-padding: 30 24 24 24;">

            <!-- Header droit -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Gardes"
                           style="-fx-font-size: 24; -fx-font-weight: bold;
                                  -fx-text-fill: white;
                                  -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.6),8,0,0,2);"/>
                    <Label fx:id="lblPompierSelectionne"
                           text="Aucun pompier selectionne"
                           style="-fx-font-size: 12; -fx-text-fill: rgba(255,255,255,0.6);"/>
                </VBox>
            </HBox>

            <!-- Formulaire ajout garde -->
            <VBox style="-fx-background-color: rgba(255,255,255,0.93);
                         -fx-background-radius: 14;
                         -fx-padding: 16 18;" spacing="12">

                <Label fx:id="lblTitreForm" text="Assigner une garde"
                       style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                <HBox spacing="12">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="CRENEAU"
                               style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                        <ComboBox fx:id="cbCreneau" prefWidth="200"
                                  style="-fx-background-radius: 8;"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="DATE DE GARDE"
                               style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                        <DatePicker fx:id="dpDateGarde" prefWidth="200"
                                    style="-fx-background-radius: 8;"/>
                    </VBox>
                </HBox>

                <HBox spacing="10">
                    <Button fx:id="btnSauvegarder" text="Sauvegarder"
                            onAction="#sauvegarderGarde"
                            style="-fx-background-color: #16a34a;
                                   -fx-text-fill: white; -fx-font-size: 12;
                                   -fx-font-weight: bold;
                                   -fx-padding: 9 20; -fx-background-radius: 8;
                                   -fx-cursor: hand;"/>
                    <Button text="Annuler" onAction="#annulerEdition"
                            style="-fx-background-color: #e2e8f0;
                                   -fx-text-fill: #475569; -fx-font-size: 12;
                                   -fx-padding: 9 16; -fx-background-radius: 8;
                                   -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- Liste gardes -->
            <VBox VBox.vgrow="ALWAYS"
                  style="-fx-background-color: rgba(255,255,255,0.93);
                         -fx-background-radius: 14;" spacing="0">
                <HBox style="-fx-padding: 10 14;
                             -fx-background-color: rgba(248,250,252,0.98);
                             -fx-background-radius: 14 14 0 0;
                             -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                    <Label text="Pompier" prefWidth="160"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                    <Label text="Telephone" prefWidth="120"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                    <Label text="Creneau" prefWidth="100"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                    <Label text="Date" prefWidth="90"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                    <Label text="Actions"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                </HBox>
                <ListView fx:id="listGardes" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: transparent;
                                 -fx-border-color: transparent;
                                 -fx-padding: 0;"/>
            </VBox>

        </VBox>
    </StackPane>

</HBox>