<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.pompier.controllers.PompierController"
      prefWidth="1280" prefHeight="800"
      minWidth="900" minHeight="600"
      style="-fx-background-color: #0d1f14;">

    <!-- SIDEBAR -->
    <VBox fx:id="menuLateral" prefWidth="240"
          style="-fx-background-color: #111c14; -fx-border-color: #1e3322; -fx-border-width: 0 1 0 0; -fx-min-width: 72;">
        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 24 16 20 16;">
            <ImageView fitWidth="44" fitHeight="44" preserveRatio="true"><image><Image url="@logo.png"/></image></ImageView>
            <VBox fx:id="logoNom" spacing="2">
                <Label text="ForestGuard" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Surveillance Intelligente" style="-fx-font-size: 10; -fx-text-fill: #4ade80;"/>
            </VBox>
        </HBox>
        <Separator style="-fx-background-color: #1e3322; -fx-opacity: 0.6;"/>
        <VBox spacing="3" style="-fx-padding: 16 10 0 10;" VBox.vgrow="ALWAYS">
            <Button fx:id="btnDashboard" prefWidth="220" prefHeight="46" text="&#x1F3E0;  Dashboard" onAction="#afficherVueDashboard"
                    style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 10 16; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian,rgba(22,163,74,0.4),10,0,0,3);"/>
            <Button fx:id="btnPompiers" prefWidth="220" prefHeight="46" text="&#x1F692;  Pompiers" onAction="#afficherVuePompiers"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 16; -fx-background-radius: 12; -fx-cursor: hand;"/>
            <Button fx:id="btnForets" prefWidth="220" prefHeight="46" text="&#x1F332;  Forets" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 16; -fx-background-radius: 12; -fx-cursor: hand;"/>
            <Button fx:id="btnCapteurs" prefWidth="220" prefHeight="46" text="&#x1F4E1;  Capteurs" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 16; -fx-background-radius: 12; -fx-cursor: hand;"/>
            <Button fx:id="btnDonnees" prefWidth="220" prefHeight="46" text="&#x1F4CA;  Donnees" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 16; -fx-background-radius: 12; -fx-cursor: hand;"/>
            <Button fx:id="btnAlertes" prefWidth="220" prefHeight="46" text="&#x1F6A8;  Alertes" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 16; -fx-background-radius: 12; -fx-cursor: hand;"/>
            <Button fx:id="btnUtilisateurs" prefWidth="220" prefHeight="46" text="&#x1F464;  Utilisateurs" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 16; -fx-background-radius: 12; -fx-cursor: hand;"/>
        </VBox>
        <Region VBox.vgrow="ALWAYS" style="-fx-background-color: linear-gradient(to top,rgba(22,163,74,0.12),transparent); -fx-min-height: 60;"/>
        <!-- Bouton Déconnexion -->
        <VBox style="-fx-padding: 10 10 6 10; -fx-border-color: #1e3322; -fx-border-width: 1 0 0 0;">
            <Button fx:id="btnDeconnexion" prefWidth="220" prefHeight="42"
                    text="&#x1F511;  Deconnexion" onAction="#handleDeconnexion"
                    style="-fx-background-color: rgba(220,38,38,0.12); -fx-text-fill: #fca5a5;
                           -fx-font-size: 13; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 16; -fx-background-radius: 12; -fx-cursor: hand;
                           -fx-border-color: rgba(220,38,38,0.25); -fx-border-radius: 12; -fx-border-width: 1;"/>
        </VBox>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10 16 14 16; -fx-border-color: #1e3322; -fx-border-width: 1 0 0 0;">
            <Button prefWidth="44" prefHeight="34" text="&lt;" onAction="#toggleMenu"
                    style="-fx-background-color: #1a2e1e; -fx-background-radius: 10; -fx-border-color: #2d5a37; -fx-border-radius: 10; -fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #4ade80; -fx-cursor: hand;"/>
            <Label text="Reduire" style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>

    <!-- CONTENU PRINCIPAL -->
    <StackPane HBox.hgrow="ALWAYS" fx:id="mainStackPane">
        <ImageView fx:id="bgImageView" fitWidth="1920" fitHeight="1080" preserveRatio="false" opacity="0.55">
            <image><Image url="@foret.png"/></image>
        </ImageView>
        <VBox style="-fx-background-color: rgba(5,20,8,0.38);" maxWidth="Infinity" maxHeight="Infinity" StackPane.alignment="TOP_LEFT"/>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox spacing="0" style="-fx-background-color: transparent;">

                <!-- HEADER -->
                <VBox fx:id="headerPrincipal" style="-fx-padding: 30 30 18 30;" spacing="16">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblTitrePage" text="Tableau de Bord" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.7),10,0,0,3);"/>
                            <Label fx:id="lblSousTitrePage" text="Vue d'ensemble de l'application ForestGuard" style="-fx-font-size: 13; -fx-text-fill: rgba(255,255,255,0.65);"/>
                        </VBox>
                        <Button fx:id="btnActionHeader" text="+ Ajouter un Pompier" onAction="#ouvrirAjout"
                                visible="false" managed="false"
                                style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 10 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian,rgba(22,163,74,0.6),14,0,0,4);"/>
                        <Button fx:id="btnExportHeader" text="&#x1F4C4; Export PDF" onAction="#ouvrirMenuExport"
                                visible="false" managed="false"
                                style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 10 18; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian,rgba(220,38,38,0.5),10,0,0,3);"/>
                    </HBox>

                    <!-- Stats (cachées sur le dashboard, visibles sur les autres vues) -->
                    <HBox fx:id="statsBar" spacing="14" visible="false" managed="false">
                        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS" style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 18; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 18; -fx-border-width: 1; -fx-padding: 16 20;">
                            <Label text="DISPONIBLES" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #4ade80;"/>
                            <Label fx:id="lblDisponibles" text="--" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #4ade80;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS" style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 18; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 18; -fx-border-width: 1; -fx-padding: 16 20;">
                            <Label text="EN MISSION" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #fca5a5;"/>
                            <Label fx:id="lblEnMission" text="--" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #fca5a5;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS" style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 18; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 18; -fx-border-width: 1; -fx-padding: 16 20;">
                            <Label text="TOTAL POMPIERS" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label fx:id="lblTotal" text="--" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS" style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 18; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 18; -fx-border-width: 1; -fx-padding: 16 20;">
                            <Label text="GARDES ACTIVES" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #fbbf24;"/>
                            <Label fx:id="lblGardes" text="--" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #fbbf24;"/>
                        </VBox>
                    </HBox>

                    <!-- ONGLETS : Pompiers | Gardes | Affectations (cachés sur le dashboard) -->
                    <HBox fx:id="barreOnglets" spacing="0" alignment="CENTER_LEFT" visible="false" managed="false">
                        <Button fx:id="btnTabPompiers" text="  Pompiers" onAction="#afficherVuePompiers"
                                prefHeight="40" prefWidth="160"
                                style="-fx-background-color: rgba(255,255,255,0.35); -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand; -fx-background-radius: 10 0 0 10; -fx-border-color: rgba(255,255,255,0.5); -fx-border-width: 1; -fx-border-radius: 10 0 0 10;"/>
                        <Button fx:id="btnTabGardes" text="  Gardes" onAction="#afficherVueGardes"
                                prefHeight="40" prefWidth="160"
                                style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand; -fx-background-radius: 0; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 0;"/>
                        <Button fx:id="btnTabAffectations" text="  Affectations" onAction="#afficherVueAffectations"
                                prefHeight="40" prefWidth="180"
                                style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand; -fx-background-radius: 0; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 0;"/>
                        <Button fx:id="btnTabIA" text="  IA Perf." onAction="#afficherVueIA"
                                prefHeight="40" prefWidth="140"
                                style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand; -fx-background-radius: 0; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 0;"/>
                        <Button fx:id="btnTabChatbot" text="  Assistant IA" onAction="#afficherVueChatbot"
                                prefHeight="40" prefWidth="160"
                                style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand; -fx-background-radius: 0 10 10 0; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 0 10 10 0;"/>
                    </HBox>
                </VBox>

                <!-- CORPS -->
                <VBox spacing="14" style="-fx-padding: 0 24 24 24;">

                    <!-- Barre de recherche (visible uniquement en mode Pompiers) -->
                    <HBox fx:id="barreRecherche" visible="false" managed="false"
                          style="-fx-background-color: rgba(255,255,255,0.93); -fx-background-radius: 16; -fx-border-color: rgba(255,255,255,0.98); -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 14 18; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.18),14,0,0,4);">
                        <TextField fx:id="tfRecherche" promptText="Rechercher par nom, prenom, email..." HBox.hgrow="ALWAYS"
                                   style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e2e8f0; -fx-padding: 9 14; -fx-font-size: 13;"/>
                    </HBox>

                    <!-- ═══════════════════════════════════════════ -->
                    <!-- VUE DASHBOARD (affichée par défaut)         -->
                    <!-- ═══════════════════════════════════════════ -->
                    <VBox fx:id="vueDashboard" spacing="20">

                        <!-- Message de bienvenue -->
                        <VBox spacing="6" style="-fx-background-color: rgba(22,163,74,0.15); -fx-background-radius: 18; -fx-border-color: rgba(74,222,128,0.35); -fx-border-radius: 18; -fx-border-width: 1.5; -fx-padding: 22 28;">
                            <HBox spacing="14" alignment="CENTER_LEFT">
                                <Label text="&#x1F44B;" style="-fx-font-size: 32;"/>
                                <VBox spacing="4">
                                    <Label text="Bienvenue, Administrateur" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                    <Label fx:id="lblDateHeure" text="" style="-fx-font-size: 13; -fx-text-fill: rgba(134,239,172,0.85);"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Cartes de stats globales -->
                        <HBox spacing="16">
                            <!-- Pompiers disponibles -->
                            <VBox fx:id="cardDispo" alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS"
                                  onMouseClicked="#afficherVuePompiers"
                                  style="-fx-background-color: rgba(22,163,74,0.18); -fx-background-radius: 20; -fx-border-color: rgba(74,222,128,0.45); -fx-border-radius: 20; -fx-border-width: 1.5; -fx-padding: 28 20; -fx-cursor: hand;">
                                <Label text="&#x1F7E2;" style="-fx-font-size: 36;"/>
                                <Label fx:id="lblDashDispo" text="--" style="-fx-font-size: 42; -fx-font-weight: bold; -fx-text-fill: #4ade80;"/>
                                <Label text="DISPONIBLES" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #4ade80;"/>
                                <Label text="Cliquer pour voir" style="-fx-font-size: 10; -fx-text-fill: rgba(74,222,128,0.55);"/>
                            </VBox>
                            <!-- En mission -->
                            <VBox fx:id="cardMission" alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS"
                                  onMouseClicked="#afficherVuePompiers"
                                  style="-fx-background-color: rgba(239,68,68,0.15); -fx-background-radius: 20; -fx-border-color: rgba(252,165,165,0.40); -fx-border-radius: 20; -fx-border-width: 1.5; -fx-padding: 28 20; -fx-cursor: hand;">
                                <Label text="&#x1F692;" style="-fx-font-size: 36;"/>
                                <Label fx:id="lblDashMission" text="--" style="-fx-font-size: 42; -fx-font-weight: bold; -fx-text-fill: #fca5a5;"/>
                                <Label text="EN MISSION" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #fca5a5;"/>
                                <Label text="Cliquer pour voir" style="-fx-font-size: 10; -fx-text-fill: rgba(252,165,165,0.55);"/>
                            </VBox>
                            <!-- Total pompiers -->
                            <VBox fx:id="cardTotal" alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS"
                                  onMouseClicked="#afficherVuePompiers"
                                  style="-fx-background-color: rgba(255,255,255,0.10); -fx-background-radius: 20; -fx-border-color: rgba(255,255,255,0.25); -fx-border-radius: 20; -fx-border-width: 1.5; -fx-padding: 28 20; -fx-cursor: hand;">
                                <Label text="&#x1F464;" style="-fx-font-size: 36;"/>
                                <Label fx:id="lblDashTotal" text="--" style="-fx-font-size: 42; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label text="TOTAL POMPIERS" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.85);"/>
                                <Label text="Cliquer pour voir" style="-fx-font-size: 10; -fx-text-fill: rgba(255,255,255,0.40);"/>
                            </VBox>
                            <!-- Gardes actives -->
                            <VBox fx:id="cardGardes" alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS"
                                  onMouseClicked="#afficherVueGardes"
                                  style="-fx-background-color: rgba(251,191,36,0.15); -fx-background-radius: 20; -fx-border-color: rgba(251,191,36,0.40); -fx-border-radius: 20; -fx-border-width: 1.5; -fx-padding: 28 20; -fx-cursor: hand;">
                                <Label text="&#x1F550;" style="-fx-font-size: 36;"/>
                                <Label fx:id="lblDashGardes" text="--" style="-fx-font-size: 42; -fx-font-weight: bold; -fx-text-fill: #fbbf24;"/>
                                <Label text="GARDES ACTIVES" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #fbbf24;"/>
                                <Label text="Cliquer pour voir" style="-fx-font-size: 10; -fx-text-fill: rgba(251,191,36,0.55);"/>
                            </VBox>
                        </HBox>

                        <!-- Modules de navigation -->
                        <Label text="Modules de l'application" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.85); -fx-padding: 8 0 0 0;"/>

                        <HBox spacing="16">
                            <!-- Gestion Pompiers -->
                            <VBox fx:id="navPompiers" spacing="12" HBox.hgrow="ALWAYS"
                                  onMouseClicked="#afficherVuePompiers"
                                  style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 18; -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 18; -fx-border-width: 1; -fx-padding: 22 20; -fx-cursor: hand;">
                                <Label text="&#x1F692;" style="-fx-font-size: 30;"/>
                                <Label text="Gestion Pompiers" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label text="Ajouter, modifier, supprimer&#10;et consulter les pompiers" wrapText="true"
                                       style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.55); -fx-line-spacing: 3;"/>
                            </VBox>
                            <!-- Gestion Gardes -->
                            <VBox fx:id="navGardes" spacing="12" HBox.hgrow="ALWAYS"
                                  onMouseClicked="#afficherVueGardes"
                                  style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 18; -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 18; -fx-border-width: 1; -fx-padding: 22 20; -fx-cursor: hand;">
                                <Label text="&#x1F4C5;" style="-fx-font-size: 30;"/>
                                <Label text="Gestion des Gardes" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label text="Planifier et suivre les gardes&#10;et creneaux des pompiers" wrapText="true"
                                       style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.55); -fx-line-spacing: 3;"/>
                            </VBox>
                            <!-- Affectations -->
                            <VBox fx:id="navAffectations" spacing="12" HBox.hgrow="ALWAYS"
                                  onMouseClicked="#afficherVueAffectations"
                                  style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 18; -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 18; -fx-border-width: 1; -fx-padding: 22 20; -fx-cursor: hand;">
                                <Label text="&#x1F6A8;" style="-fx-font-size: 30;"/>
                                <Label text="Affectations" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label text="Gerer les alertes et affecter&#10;les pompiers aux interventions" wrapText="true"
                                       style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.55); -fx-line-spacing: 3;"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="16">
                            <!-- IA Performance -->
                            <VBox fx:id="navIA" spacing="12" HBox.hgrow="ALWAYS"
                                  onMouseClicked="#afficherVueIA"
                                  style="-fx-background-color: rgba(139,92,246,0.15); -fx-background-radius: 18; -fx-border-color: rgba(167,139,250,0.35); -fx-border-radius: 18; -fx-border-width: 1; -fx-padding: 22 20; -fx-cursor: hand;">
                                <Label text="&#x1F4CA;" style="-fx-font-size: 30;"/>
                                <Label text="IA Performance" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #c4b5fd;"/>
                                <Label text="Analyser les performances&#10;des pompiers par IA" wrapText="true"
                                       style="-fx-font-size: 11; -fx-text-fill: rgba(196,181,253,0.60); -fx-line-spacing: 3;"/>
                            </VBox>
                            <!-- Assistant IA -->
                            <VBox fx:id="navChatbot" spacing="12" HBox.hgrow="ALWAYS"
                                  onMouseClicked="#afficherVueChatbot"
                                  style="-fx-background-color: rgba(6,182,212,0.12); -fx-background-radius: 18; -fx-border-color: rgba(103,232,249,0.30); -fx-border-radius: 18; -fx-border-width: 1; -fx-padding: 22 20; -fx-cursor: hand;">
                                <Label text="&#x1F916;" style="-fx-font-size: 30;"/>
                                <Label text="Assistant IA" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #67e8f9;"/>
                                <Label text="Posez vos questions a&#10;l'assistant intelligent" wrapText="true"
                                       style="-fx-font-size: 11; -fx-text-fill: rgba(103,232,249,0.55); -fx-line-spacing: 3;"/>
                            </VBox>
                            <!-- Placeholder -->
                            <VBox HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: rgba(255,255,255,0.04); -fx-background-radius: 18; -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 18; -fx-border-width: 1; -fx-padding: 22 20;">
                                <Label text="&#x1F332;" style="-fx-font-size: 30;"/>
                                <Label text="ForestGuard" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.35);"/>
                                <Label text="Surveillance intelligente&#10;des forets en temps reel" wrapText="true"
                                       style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.25); -fx-line-spacing: 3;"/>
                            </VBox>
                        </HBox>

