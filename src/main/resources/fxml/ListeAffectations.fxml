<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.ListeAffectationsController"
           prefWidth="900" prefHeight="650">

    <!-- Background Image avec overlay -->
    <StackPane>
        <ImageView fitWidth="900" fitHeight="650" preserveRatio="false">
            <image>
                <javafx.scene.image.Image url="@../image/foret-back.jpg"/>
            </image>
        </ImageView>
        <!-- Overlay sombre pour la lisibilité -->
        <VBox style="-fx-background-color: rgba(5, 20, 8, 0.88);"/>
    </StackPane>

    <!-- Contenu principal -->
    <VBox spacing="0" style="-fx-background-color: transparent;">

        <!-- ══ HEADER AVEC LOGO ══ -->
        <HBox spacing="12" alignment="CENTER_LEFT"
              style="-fx-background-color: #16a34a;
                     -fx-padding: 16 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 8, 0, 0, 2);">
            <!-- Logo -->
            <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                <image>
                    <javafx.scene.image.Image url="@../image/foret-logo.png"/>
                </image>
            </ImageView>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Mes Affectations"
                       style="-fx-font-size: 17; -fx-font-weight: bold;
                              -fx-text-fill: white;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 3, 0, 0, 1);"/>
                <Label text="Gérez vos missions assignées"
                       style="-fx-font-size: 10;
                              -fx-text-fill: rgba(255,255,255,0.85);"/>
            </VBox>
            <!-- Badge compteur -->
            <Label fx:id="lblCompteur" text="0 en attente"
                   style="-fx-background-color: rgba(255,255,255,0.2);
                          -fx-text-fill: white;
                          -fx-font-size: 11;
                          -fx-font-weight: bold;
                          -fx-background-radius: 12;
                          -fx-padding: 6 12;"/>
        </HBox>

        <!-- ══ LISTE DES AFFECTATIONS ══ -->
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;
                           -fx-border-color: transparent;">
            <VBox spacing="12" style="-fx-padding: 20;">
                <ListView fx:id="listeAffectations" prefHeight="500"
                          style="-fx-background-color: transparent;
                                 -fx-border-color: transparent;
                                 -fx-background-insets: 0;
                                 -fx-padding: 0;"/>
            </VBox>
        </ScrollPane>

        <!-- ══ BOUTON FERMER ══ -->
        <HBox spacing="12" alignment="CENTER"
              style="-fx-padding: 16 20;
                     -fx-background-color: rgba(17, 28, 20, 0.95);
                     -fx-border-color: #1e3322;
                     -fx-border-width: 1 0 0 0;">
            <Button text="Fermer"
                    onAction="#handleFermer"
                    style="-fx-background-color: #1a2e1e;
                           -fx-text-fill: #94a3b8; -fx-font-size: 13;
                           -fx-padding: 11 32; -fx-background-radius: 10;
                           -fx-border-color: #2d5a37; -fx-border-radius: 10;
                           -fx-cursor: hand;"/>
        </HBox>

    </VBox>
</StackPane>
