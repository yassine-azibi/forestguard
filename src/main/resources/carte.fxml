<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.web.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.capteur.controllers.MapController"
      prefWidth="1200" prefHeight="780"
      style="-fx-background-color: #0a1410;">

    <!-- Barre de statut en bas -->
    <HBox alignment="CENTER_LEFT" spacing="16"
          style="-fx-padding: 0 20 0 20;
                 -fx-background-color: #060e09;
                 -fx-border-color: #16a34a; -fx-border-width: 0 0 0 0;
                 -fx-min-height: 38; -fx-max-height: 38;">

        <!-- Indicateur point vert animé -->
        <Label text="●"
               style="-fx-font-size: 10; -fx-text-fill: #4ade80;"/>
        <Label fx:id="lblStatutCarte"
               text="Chargement de la carte OpenStreetMap..."
               style="-fx-font-size: 12; -fx-text-fill: #94a3b8;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Boutons de filtre rapide (appellent JS via controller) -->
        <Label text="Filtre rapide :"
               style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
        <Button text="Tous" onAction="#filtrerTous"
                style="-fx-background-color: #334155; -fx-text-fill: white;
                       -fx-font-size: 11; -fx-font-weight: bold;
                       -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 4 12;
                       -fx-border-color: #475569; -fx-border-radius: 20;"/>
        <Button text="Actifs" onAction="#filtrerActifs"
                style="-fx-background-color: rgba(22,163,74,0.2); -fx-text-fill: #4ade80;
                       -fx-font-size: 11; -fx-font-weight: bold;
                       -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 4 12;
                       -fx-border-color: #16a34a; -fx-border-radius: 20;"/>
        <Button text="En panne" onAction="#filtrerEnPanne"
                style="-fx-background-color: rgba(220,38,38,0.2); -fx-text-fill: #fca5a5;
                       -fx-font-size: 11; -fx-font-weight: bold;
                       -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 4 12;
                       -fx-border-color: #dc2626; -fx-border-radius: 20;"/>
        <Button text="Inactifs" onAction="#filtrerInactifs"
                style="-fx-background-color: rgba(100,116,139,0.2); -fx-text-fill: #cbd5e1;
                       -fx-font-size: 11; -fx-font-weight: bold;
                       -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 4 12;
                       -fx-border-color: #64748b; -fx-border-radius: 20;"/>

        <Region prefWidth="8"/>
        <Separator orientation="VERTICAL"
                   style="-fx-background-color: #1e3322; -fx-opacity: 0.7;"/>
        <Region prefWidth="4"/>

        <Button text="✕  Fermer" onAction="#fermer"
                style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626;
                       -fx-font-weight: bold; -fx-background-radius: 8;
                       -fx-cursor: hand; -fx-padding: 5 14; -fx-font-size: 11;
                       -fx-border-color: #fca5a5; -fx-border-radius: 8;"/>
    </HBox>

    <!-- Carte Leaflet via WebView - occupe tout l'espace -->
    <WebView fx:id="mapWebView" VBox.vgrow="ALWAYS"/>

</VBox>
