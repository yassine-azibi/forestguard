<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.StatistiquesController"
      prefWidth="1100" prefHeight="750"
      style="-fx-background-color: #0d1f14;">

    <!-- ══════════ SIDEBAR ══════════ -->
    <VBox prefWidth="300" minWidth="300" maxWidth="300"
          style="-fx-background-color: #111c14;
                 -fx-border-color: #1e3322;
                 -fx-border-width: 0 1 0 0;">

        <HBox spacing="12" alignment="CENTER_LEFT"
              style="-fx-padding: 28 24 24 24;">
            <!-- Logo -->
            <ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
                <image>
                    <javafx.scene.image.Image url="@../image/foret-logo.png"/>
                </image>
            </ImageView>
            <VBox spacing="3">
                <Label text="ForestGuard"
                       style="-fx-font-size: 18; -fx-font-weight: bold;
                              -fx-text-fill: white;"/>
                <Label text="Surveillance Intelligente"
                       style="-fx-font-size: 12; -fx-text-fill: #4ade80;"/>
            </VBox>
        </HBox>

        <Separator style="-fx-background-color: #1e3322; -fx-opacity: 0.6;"/>

        <VBox spacing="4"
              style="-fx-padding: 20 16 0 16;" VBox.vgrow="ALWAYS">

            <Button prefWidth="268" prefHeight="48"
                    text="  📋  Interventions"
                    onAction="#handleRetour"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #94a3b8; -fx-font-size: 14;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20; -fx-background-radius: 12;
                           -fx-cursor: hand;"/>

            <Button prefWidth="268" prefHeight="48"
                    text="  📊  Statistiques"
                    style="-fx-background-color: #16a34a;
                           -fx-text-fill: white; -fx-font-size: 14;
                           -fx-font-weight: bold;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20; -fx-background-radius: 12;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian,rgba(22,163,74,0.4),10,0,0,3);"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"
                style="-fx-background-color: linear-gradient(to top,rgba(22,163,74,0.12),transparent);
                       -fx-min-height: 60;"/>

        <VBox style="-fx-padding: 16 24;
                     -fx-border-color: #1e3322;
                     -fx-border-width: 1 0 0 0;" spacing="5">
            <Label text="John Martinez"
                   style="-fx-font-size: 14; -fx-font-weight: bold;
                          -fx-text-fill: white;"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="●" style="-fx-text-fill: #4ade80; -fx-font-size: 11;"/>
                <Label text="Disponible"
                       style="-fx-font-size: 12; -fx-text-fill: #4ade80;"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- ══════════ CONTENU ══════════ -->
    <StackPane HBox.hgrow="ALWAYS">

        <!-- Background Image avec overlay -->
        <StackPane>
            <ImageView fitWidth="1100" fitHeight="750" preserveRatio="false">
                <image>
                    <javafx.scene.image.Image url="@../image/foret-back.jpg"/>
                </image>
            </ImageView>
            <!-- Overlay sombre pour la lisibilité -->
            <VBox style="-fx-background-color: rgba(5, 20, 8, 0.85);"/>
        </StackPane>

        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;
                           -fx-border-color: transparent;">
            <VBox spacing="0" style="-fx-background-color: transparent;">

                <!-- HEADER -->
                <VBox style="-fx-padding: 36 36 28 36;" spacing="20">
                    <VBox spacing="6">
                        <Label text="Statistiques des Interventions"
                               style="-fx-font-size: 30; -fx-font-weight: bold;
                                      -fx-text-fill: white;
                                      -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.6),10,0,0,3);"/>
                        <Label text="Analyse complète de vos performances terrain"
                               style="-fx-font-size: 14;
                                      -fx-text-fill: rgba(255,255,255,0.6);"/>
                    </VBox>

                    <!-- STAT CARDS -->
                    <HBox spacing="16">
                        <VBox fx:id="cardTotal" alignment="CENTER" spacing="6"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(255,255,255,0.08);
                                     -fx-background-radius: 20;
                                     -fx-border-color: rgba(255,255,255,0.15);
                                     -fx-border-radius: 20; -fx-border-width: 1;
                                     -fx-padding: 20 24; -fx-cursor: hand;">
                            <Label text="Total"
                                   style="-fx-font-size: 11;
                                          -fx-text-fill: rgba(255,255,255,0.55);"/>
                            <Label fx:id="lblTotal" text="0"
                                   style="-fx-font-size: 28; -fx-font-weight: bold;
                                          -fx-text-fill: #4ade80;"/>
                        </VBox>
                        <VBox fx:id="cardMax" alignment="CENTER" spacing="6"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(255,255,255,0.08);
                                     -fx-background-radius: 20;
                                     -fx-border-color: rgba(255,255,255,0.15);
                                     -fx-border-radius: 20; -fx-border-width: 1;
                                     -fx-padding: 20 24; -fx-cursor: hand;">
                            <Label text="Max / Jour"
                                   style="-fx-font-size: 11;
                                          -fx-text-fill: rgba(255,255,255,0.55);"/>
                            <Label fx:id="lblMax" text="0"
                                   style="-fx-font-size: 28; -fx-font-weight: bold;
                                          -fx-text-fill: #f97316;"/>
                        </VBox>
                        <VBox fx:id="cardMoyenne" alignment="CENTER" spacing="6"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(255,255,255,0.08);
                                     -fx-background-radius: 20;
                                     -fx-border-color: rgba(255,255,255,0.15);
                                     -fx-border-radius: 20; -fx-border-width: 1;
                                     -fx-padding: 20 24; -fx-cursor: hand;">
                            <Label text="Moyenne / Jour"
                                   style="-fx-font-size: 11;
                                          -fx-text-fill: rgba(255,255,255,0.55);"/>
                            <Label fx:id="lblMoyenne" text="0"
                                   style="-fx-font-size: 28; -fx-font-weight: bold;
                                          -fx-text-fill: #93c5fd;"/>
                        </VBox>
                        <VBox fx:id="cardTaux" alignment="CENTER" spacing="6"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(255,255,255,0.08);
                                     -fx-background-radius: 20;
                                     -fx-border-color: rgba(255,255,255,0.15);
                                     -fx-border-radius: 20; -fx-border-width: 1;
                                     -fx-padding: 20 24; -fx-cursor: hand;">
                            <Label text="Taux réussite"
                                   style="-fx-font-size: 11;
                                          -fx-text-fill: rgba(255,255,255,0.55);"/>
                            <Label fx:id="lblTaux" text="0%"
                                   style="-fx-font-size: 28; -fx-font-weight: bold;
                                          -fx-text-fill: #fcd34d;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- CHARTS -->
                <VBox spacing="16" style="-fx-padding: 0 24 24 24;">

                    <!-- LINE CHART -->
                    <VBox style="-fx-background-color: rgba(255,255,255,0.93);
                                 -fx-background-radius: 18;
                                 -fx-border-color: rgba(255,255,255,0.98);
                                 -fx-border-radius: 18; -fx-border-width: 1;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.25),16,0,0,4);
                                 -fx-padding: 20;">
                        <Label text="📈 Interventions par jour"
                               style="-fx-font-size: 14; -fx-font-weight: bold;
                                      -fx-text-fill: #0f172a; -fx-padding: 0 0 10 0;"/>
                        <LineChart fx:id="lineChart" prefHeight="280"
                                   style="-fx-background-color: transparent;">
                            <xAxis><CategoryAxis fx:id="xAxis"/></xAxis>
                            <yAxis><NumberAxis fx:id="yAxis"/></yAxis>
                        </LineChart>
                    </VBox>

                    <!-- BAR + PIE CHARTS côte à côte -->
                    <HBox spacing="16">

                        <!-- BAR CHART -->
                        <VBox HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(255,255,255,0.93);
                                     -fx-background-radius: 18;
                                     -fx-border-color: rgba(255,255,255,0.98);
                                     -fx-border-radius: 18; -fx-border-width: 1;
                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.25),16,0,0,4);
                                     -fx-padding: 20;">
                            <Label text="📊 Interventions par zone"
                                   style="-fx-font-size: 14; -fx-font-weight: bold;
                                          -fx-text-fill: #0f172a; -fx-padding: 0 0 10 0;"/>
                            <BarChart fx:id="barChart" prefHeight="260"
                                      style="-fx-background-color: transparent;">
                                <xAxis><CategoryAxis fx:id="xAxisBar"/></xAxis>
                                <yAxis><NumberAxis fx:id="yAxisBar"/></yAxis>
                            </BarChart>
                        </VBox>

                        <!-- PIE CHART -->
                        <VBox HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(255,255,255,0.93);
                                     -fx-background-radius: 18;
                                     -fx-border-color: rgba(255,255,255,0.98);
                                     -fx-border-radius: 18; -fx-border-width: 1;
                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.25),16,0,0,4);
                                     -fx-padding: 20;">
                            <Label text="🥧 Répartition des statuts"
                                   style="-fx-font-size: 14; -fx-font-weight: bold;
                                          -fx-text-fill: #0f172a; -fx-padding: 0 0 10 0;"/>
                            <PieChart fx:id="pieChart" prefHeight="260"
                                      style="-fx-background-color: transparent;"/>
                        </VBox>

                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </StackPane>

</HBox>