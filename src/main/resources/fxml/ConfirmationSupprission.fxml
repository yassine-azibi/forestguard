<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<!--
    Panneau de confirmation de suppression - Thème ForestGuard
    Controller : controllers.ConfirmationSuppressionController
    Usage      : FXMLLoader.load(getClass().getResource("/views/ConfirmationSuppression.fxml"))
-->
<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.ConfirmationSuppressionController"
           prefWidth="500" prefHeight="340"
           style="-fx-background-color: rgba(13,31,20,0.85);">

    <!-- Fond semi-transparent (overlay) -->
    <Rectangle width="500" height="340"
               fill="rgba(0,0,0,0.55)"
               arcWidth="0" arcHeight="0"/>

    <!-- Carte principale -->
    <VBox alignment="TOP_LEFT" spacing="0"
          maxWidth="380" maxHeight="320"
          style="-fx-background-color: #111c14;
                 -fx-background-radius: 16;
                 -fx-border-color: #1e3322;
                 -fx-border-width: 1;
                 -fx-border-radius: 16;
                 -fx-padding: 28 28 24 28;
                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.7),24,0,0,6);">

        <!-- Bouton fermer (X) en haut à droite -->
        <StackPane>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <!-- Icône rouge poubelle -->
                <StackPane>
                    <Circle radius="26"
                            fill="rgba(239,68,68,0.13)"
                            stroke="rgba(239,68,68,0.28)"
                            strokeWidth="1"/>
                    <Label text="🗑"
                           style="-fx-font-size: 20;"/>
                </StackPane>
            </HBox>
            <HBox alignment="CENTER_RIGHT">
                <Button fx:id="btnFermer" text="✕"
                        onAction="#fermer"
                        style="-fx-background-color: #1a2e1e;
                               -fx-background-radius: 10;
                               -fx-border-color: #2d5a37;
                               -fx-border-radius: 10;
                               -fx-border-width: 1;
                               -fx-text-fill: #4ade80;
                               -fx-font-size: 13;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;
                               -fx-pref-width: 32;
                               -fx-pref-height: 32;
                               -fx-padding: 0;"/>
            </HBox>
        </StackPane>

        <VBox.margin>
            <Insets bottom="16"/>
        </VBox.margin>

        <!-- Titre -->
        <Label text="Confirmer la suppression"
               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label text="Cette action est irréversible"
               style="-fx-font-size: 12; -fx-text-fill: rgba(255,255,255,0.4); -fx-padding: 2 0 0 0;"/>

        <VBox.margin>
            <Insets top="0" bottom="14"/>
        </VBox.margin>

        <!-- Encadré forêt -->
        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-background-color: rgba(255,255,255,0.06);
                     -fx-background-radius: 12;
                     -fx-border-color: #1e3322;
                     -fx-border-radius: 12;
                     -fx-border-width: 1;
                     -fx-padding: 10 14;">
            <Label text="🌲"
                   style="-fx-font-size: 18;"/>
            <VBox spacing="2">
                <Label text="Forêt"
                       style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                <Label fx:id="lblNomForet" text="Forêt de Siliana"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>
        </HBox>

        <VBox.margin>
            <Insets top="14" bottom="14"/>
        </VBox.margin>

        <!-- Message d'avertissement -->
        <Label text="Toutes les données associées seront définitivement supprimées. Voulez-vous continuer ?"
               wrapText="true"
               style="-fx-font-size: 12; -fx-text-fill: rgba(255,255,255,0.5); -fx-line-spacing: 2;"/>

        <VBox.margin>
            <Insets top="0" bottom="20"/>
        </VBox.margin>

        <!-- Boutons -->
        <HBox spacing="10">
            <!-- Annuler -->
            <Button fx:id="btnAnnuler" text="Annuler"
                    onAction="#fermer"
                    HBox.hgrow="ALWAYS"
                    maxWidth="Infinity"
                    prefHeight="40"
                    style="-fx-background-color: #1a2e1e;
                           -fx-background-radius: 12;
                           -fx-border-color: #2d5a37;
                           -fx-border-radius: 12;
                           -fx-border-width: 1;
                           -fx-text-fill: #94a3b8;
                           -fx-font-size: 13;
                           -fx-cursor: hand;"/>

            <!-- Supprimer -->
            <Button fx:id="btnSupprimer" text="🗑  Supprimer"
                    onAction="#confirmerSuppression"
                    HBox.hgrow="ALWAYS"
                    maxWidth="Infinity"
                    prefHeight="40"
                    style="-fx-background-color: rgba(239,68,68,0.18);
                           -fx-background-radius: 12;
                           -fx-border-color: rgba(239,68,68,0.4);
                           -fx-border-radius: 12;
                           -fx-border-width: 1;
                           -fx-text-fill: #fca5a5;
                           -fx-font-size: 13;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;"/>
        </HBox>

    </VBox>
</StackPane>
