<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.DashboardAgentController"
      prefWidth="1280" prefHeight="800"
      style="-fx-background-color: #0d1f14;">

    <!-- ══════════ SIDEBAR ══════════ -->
    <VBox fx:id="sidebar" prefWidth="300" minWidth="300" maxWidth="300"
          style="-fx-background-color: #111c14;
                 -fx-border-color: #1e3322;
                 -fx-border-width: 0 1 0 0;">

        <HBox spacing="12" alignment="CENTER_LEFT"
              style="-fx-padding: 28 24 24 24;">
            <!-- Logo -->
            <ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
                <image>
                    <javafx.scene.image.Image url="@../image/foret-logo.png"/>
                </image>
            </ImageView>
            <VBox spacing="3">
                <Label text="ForestGuard"
                       style="-fx-font-size: 18; -fx-font-weight: bold;
                              -fx-text-fill: white;"/>
                <Label text="Surveillance Intelligente"
                       style="-fx-font-size: 12; -fx-text-fill: #4ade80;"/>
            </VBox>
        </HBox>

        <Separator style="-fx-background-color: #1e3322; -fx-opacity: 0.6;"/>

        <VBox spacing="4"
              style="-fx-padding: 20 16 0 16;" VBox.vgrow="ALWAYS">

            <Button prefWidth="268" prefHeight="48"
                    text="  📋  Interventions"
                    style="-fx-background-color: #16a34a;
                           -fx-text-fill: white; -fx-font-size: 14;
                           -fx-font-weight: bold;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20; -fx-background-radius: 12;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian,rgba(22,163,74,0.4),10,0,0,3);"/>

            <Button prefWidth="268" prefHeight="48"
                    text="  ➕  Nouvelle Intervention"
                    onAction="#handleNewIntervention"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #94a3b8; -fx-font-size: 14;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20; -fx-background-radius: 12;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnGenererPDF" prefWidth="268" prefHeight="48"
                    text="  📄  Générer Rapport"
                    onAction="#handleGenererPDF"
                    disable="true" opacity="0.5"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #94a3b8; -fx-font-size: 14;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20; -fx-background-radius: 12;
                           -fx-cursor: hand;"/>

            <Button prefWidth="268" prefHeight="48"
                    text="  📊  Statistiques"
                    onAction="#handleStatistiques"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #94a3b8; -fx-font-size: 14;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20; -fx-background-radius: 12;
                           -fx-cursor: hand;"/>

            <!-- Bouton Mes Affectations avec badge -->
            <StackPane prefWidth="268" prefHeight="48">
                <Button fx:id="btnAffectations" prefWidth="268" prefHeight="48"
                        text="  📬  Mes Affectations"
                        onAction="#handleAffectations"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #94a3b8; -fx-font-size: 14;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 12 20; -fx-background-radius: 12;
                               -fx-cursor: hand;"/>
                <!-- Badge de notification -->
                <Label fx:id="badgeAffectations" text="0"
                       visible="false"
                       style="-fx-background-color: #dc2626;
                              -fx-text-fill: white;
                              -fx-font-size: 10;
                              -fx-font-weight: bold;
                              -fx-background-radius: 10;
                              -fx-padding: 2 6;
                              -fx-min-width: 20;
                              -fx-alignment: center;"
                       StackPane.alignment="TOP_RIGHT">
                    <StackPane.margin>
                        <Insets top="0" right="20" bottom="0" left="0"/>
                    </StackPane.margin>
                </Label>
            </StackPane>

            <!-- Séparateur -->
            <Separator style="-fx-background-color: #1e3322;
                              -fx-opacity: 0.4; -fx-padding: 8 0;"/>

            <!-- Bouton Assistant IA -->
            <Button prefWidth="268" prefHeight="52"
                    text="  🤖  Assistant IA"
                    onAction="#handleOuvrirAssistant"
                    style="-fx-background-color: rgba(124,58,237,0.2);
                           -fx-text-fill: #c4b5fd; -fx-font-size: 14;
                           -fx-font-weight: bold;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20; -fx-background-radius: 12;
                           -fx-cursor: hand;
                           -fx-border-color: rgba(124,58,237,0.4);
                           -fx-border-radius: 12; -fx-border-width: 1;"/>

        </VBox>

        <Region VBox.vgrow="ALWAYS"
                style="-fx-background-color: linear-gradient(to top,rgba(22,163,74,0.12),transparent);
                       -fx-min-height: 60;"/>

        <VBox style="-fx-padding: 16 24;
                     -fx-border-color: #1e3322;
                     -fx-border-width: 1 0 0 0;"
              spacing="5">
            <Label fx:id="lblAgentName" text="John Martinez"
                   style="-fx-font-size: 14; -fx-font-weight: bold;
                          -fx-text-fill: white;"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="●"
                       style="-fx-text-fill: #4ade80; -fx-font-size: 11;"/>
                <Label text="Disponible"
                       style="-fx-font-size: 12; -fx-text-fill: #4ade80;"/>
            </HBox>
        </VBox>
        
        <!-- Bouton Déconnexion -->
        <VBox style="-fx-padding: 10 16 16 16;">
            <Button prefWidth="268" prefHeight="44"
                    text="🔓  Déconnexion"
                    onAction="#handleDeconnexion"
                    style="-fx-background-color: rgba(220,38,38,0.15);
                           -fx-text-fill: #fca5a5; -fx-font-size: 13;
                           -fx-font-weight: bold;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 20; -fx-background-radius: 12;
                           -fx-cursor: hand;
                           -fx-border-color: rgba(220,38,38,0.3);
                           -fx-border-radius: 12; -fx-border-width: 1;"/>
        </VBox>
    </VBox>

    <!-- ══════════ CONTENU ══════════ -->
    <StackPane HBox.hgrow="ALWAYS">

        <!-- Background Image avec overlay -->
        <StackPane>
            <ImageView fitWidth="1280" fitHeight="800" preserveRatio="false">
                <image>
                    <javafx.scene.image.Image url="@../image/foret-back.jpg"/>
                </image>
            </ImageView>
            <!-- Overlay sombre pour la lisibilité (opacité augmentée) -->
            <VBox style="-fx-background-color: rgba(5, 20, 8, 0.85);"/>
        </StackPane>

        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;
                           -fx-border-color: transparent;">
            <VBox spacing="0" style="-fx-background-color: transparent;">

                <!-- ══ HEADER ══ -->
                <VBox style="-fx-padding: 36 36 28 36;" spacing="20">

                    <HBox alignment="CENTER_LEFT" spacing="18">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Gestion des Interventions"
                                   style="-fx-font-size: 32; -fx-font-weight: bold;
                                          -fx-text-fill: white;
                                          -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.9),12,0,0,4);"/>
                            <Label text="Gérez et suivez vos interventions terrain"
                                   style="-fx-font-size: 15;
                                          -fx-text-fill: rgba(255,255,255,0.85);
                                          -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.8),8,0,0,2);"/>
                        </VBox>
                    </HBox>

                    <!-- Stat cards -->
                    <HBox spacing="16">
                        <VBox fx:id="cardEnCours" alignment="CENTER" spacing="6"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(255,255,255,0.12);
                                     -fx-background-radius: 20;
                                     -fx-border-color: rgba(255,255,255,0.25);
                                     -fx-border-radius: 20; -fx-border-width: 1.5;
                                     -fx-padding: 22 24; -fx-cursor: hand;
                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.6),12,0,0,3);">
                            <Label text="En Cours"
                                   style="-fx-font-size: 12;
                                          -fx-text-fill: rgba(255,255,255,0.75);
                                          -fx-font-weight: 600;"/>
                            <Label fx:id="lblInProgress" text="0"
                                   style="-fx-font-size: 32; -fx-font-weight: bold;
                                          -fx-text-fill: #f97316;
                                          -fx-effect: dropshadow(gaussian,rgba(249,115,22,0.6),8,0,0,2);"/>
                        </VBox>
                        <VBox fx:id="cardTerminees" alignment="CENTER" spacing="6"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(255,255,255,0.12);
                                     -fx-background-radius: 20;
                                     -fx-border-color: rgba(255,255,255,0.25);
                                     -fx-border-radius: 20; -fx-border-width: 1.5;
                                     -fx-padding: 22 24; -fx-cursor: hand;
                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.6),12,0,0,3);">
                            <Label text="Terminées"
                                   style="-fx-font-size: 12;
                                          -fx-text-fill: rgba(255,255,255,0.75);
                                          -fx-font-weight: 600;"/>
                            <Label fx:id="lblCompleted" text="0"
                                   style="-fx-font-size: 32; -fx-font-weight: bold;
                                          -fx-text-fill: #4ade80;
                                          -fx-effect: dropshadow(gaussian,rgba(74,222,128,0.6),8,0,0,2);"/>
                        </VBox>
                        <VBox fx:id="cardSemaine" alignment="CENTER" spacing="6"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(255,255,255,0.12);
                                     -fx-background-radius: 20;
                                     -fx-border-color: rgba(255,255,255,0.25);
                                     -fx-border-radius: 20; -fx-border-width: 1.5;
                                     -fx-padding: 22 24; -fx-cursor: hand;
                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.6),12,0,0,3);">
                            <Label text="Cette Semaine"
                                   style="-fx-font-size: 12;
                                          -fx-text-fill: rgba(255,255,255,0.75);
                                          -fx-font-weight: 600;"/>
                            <Label fx:id="lblWeek" text="0"
                                   style="-fx-font-size: 32; -fx-font-weight: bold;
                                          -fx-text-fill: #93c5fd;
                                          -fx-effect: dropshadow(gaussian,rgba(147,197,253,0.6),8,0,0,2);"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ══ LISTE BLANCHE ══ -->
                <VBox spacing="0" style="-fx-padding: 0 24 24 24;">
                    <VBox style="-fx-background-color: rgba(255,255,255,0.96);
                                 -fx-background-radius: 18;
                                 -fx-border-color: rgba(255,255,255,0.98);
                                 -fx-border-radius: 18; -fx-border-width: 1.5;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.4),20,0,0,6);"
                          spacing="0">

                        <HBox style="-fx-padding: 14 16;
                                     -fx-background-color: rgba(248,250,252,0.98);
                                     -fx-background-radius: 16 16 0 0;
                                     -fx-border-color: #e2e8f0;
                                     -fx-border-width: 0 0 1 0;">
                            <Label text="Zone d'alerte" prefWidth="200"
                                   style="-fx-font-size: 11; -fx-font-weight: bold;
                                          -fx-text-fill: #374151;"/>
                            <Label text="Statut" prefWidth="120"
                                   style="-fx-font-size: 11; -fx-font-weight: bold;
                                          -fx-text-fill: #374151;"/>
                            <Label text="Date début" prefWidth="150"
                                   style="-fx-font-size: 11; -fx-font-weight: bold;
                                          -fx-text-fill: #374151;"/>
                            <Label text="Date fin" prefWidth="150"
                                   style="-fx-font-size: 11; -fx-font-weight: bold;
                                          -fx-text-fill: #374151;"/>
                            <Label text="Résultat" prefWidth="200"
                                   style="-fx-font-size: 11; -fx-font-weight: bold;
                                          -fx-text-fill: #374151;"/>
                            <Label text="Actions" prefWidth="120"
                                   style="-fx-font-size: 11; -fx-font-weight: bold;
                                          -fx-text-fill: #374151;"/>
                        </HBox>

                        <ListView fx:id="listeInterventions" prefHeight="460"
                                  style="-fx-background-color: transparent;
                                         -fx-border-color: transparent;
                                         -fx-background-insets: 0;
                                         -fx-padding: 0;"/>
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </StackPane>

</HBox>