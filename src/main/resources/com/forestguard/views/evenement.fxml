<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<StackPane xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.forestguard.controllers.EvenementController"
           stylesheets="@../styles/app.css">

    <!-- Image de fond : fixe derrière tout, elle ne fait pas partie du scroll -->
    <ImageView fx:id="backgroundImage"
               preserveRatio="false"
               opacity="0.7"
               fitWidth="1280" fitHeight="800"
               StackPane.alignment="CENTER">
        <image>
            <Image url="@../images/foret.jpg"/>
        </image>
    </ImageView>

    <!-- Overlay sombre pour lisibilité -->
    <Region style="-fx-background-color: rgba(0,0,0,0.45);"
            StackPane.alignment="CENTER"/>

    <!-- Contenu principal par-dessus -->
    <BorderPane style="-fx-background-color: transparent;">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="toolbar-shell">
                <padding>
                    <Insets top="12" right="18" bottom="12" left="18"/>
                </padding>
                <ImageView fitWidth="36" fitHeight="36">
                    <image>
                        <Image url="@../images/logo.png"/>
                    </image>
                </ImageView>
                <Label text="Événements Forestiers" styleClass="toolbar-brand"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnNouvelEvenement" text="+ Nouvel événement" styleClass="primary-button"/>
                <Button text="✕ Fermer" onAction="#handleBackToDashboard" styleClass="secondary-button"/>
            </HBox>
        </top>

        <center>
            <!-- ScrollPane transparent : le fond ImageView reste visible en dessous -->
            <ScrollPane fitToWidth="true" styleClass="content-scroll"
                        style="-fx-background: transparent; -fx-background-color: transparent;">
                <content>
                    <VBox spacing="12" style="-fx-background-color: transparent;">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Filtrer par type:" styleClass="meta-label"/>
                            <ComboBox fx:id="typeFilterCombo"/>
                        </HBox>
                        <VBox fx:id="evenementsListBox" spacing="14"
                              style="-fx-background-color: transparent;"/>
                    </VBox>
                </content>
            </ScrollPane>
        </center>
    </BorderPane>

</StackPane>
